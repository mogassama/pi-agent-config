#!/usr/bin/env python3
"""Validate the JSON envelope in the most recent subagent artifact."""
import json, re, sys, glob, os

role = sys.argv[1] if len(sys.argv) > 1 else ""
pattern = f"*{role}*_output.md" if role else "*_output.md"
roots = [
    os.path.join(os.getcwd(), ".pi-subagents", "artifacts"),
    os.path.expanduser("~/.pi/agent/.pi-subagents/artifacts"),
]
files = [f for r in roots for f in glob.glob(os.path.join(r, pattern))]
if not files:
    sys.exit(f"no artifact matching '{pattern}'")

latest = max(files, key=os.path.getmtime)
raw = open(latest).read()
print(f"artifact: {os.path.relpath(latest, os.path.expanduser('~'))}")

# fenced blocks, closing fence optional (truncated output)
blocks = re.findall(r"^[ \t]*```json[ \t]*\n(.*?)(?:^[ \t]*```|\Z)",
                    raw, re.S | re.M)
env = None
for b in reversed(blocks):
    try:
        env = json.loads(b)
        break
    except json.JSONDecodeError:
        continue

if env is None:
    # worker native template fallback
    if re.search(r"^Changed files:", raw, re.M):
        print("OK: worker native template (no JSON envelope)")
        for line in re.findall(
            r"^(Implemented|Changed files|Validation|Open risks/questions|Recommended next step):.*",
            raw, re.M):
            pass
        for line in raw.splitlines():
            if re.match(r"^(Implemented|Changed files|Validation|Open risks/questions|Recommended next step)", line):
                print("  " + line.strip())
        sys.exit(0)
    sys.exit("FAIL: no parsable json block")

missing = [k for k in ("agent", "status", "summary") if k not in env]
if missing:
    sys.exit(f"FAIL: missing fields: {missing}")

print(f"OK: {env['agent']} · {env['status']}")
for f in env.get("findings", []):
    print(f"  {f.get('severity','?'):6} {f.get('confidence','?'):9} {f.get('location','?')}")
if "verdict" in env:
    print(f"verdict: {env['verdict']}")
if "changed_files" in env:
    print(f"changed: {len(env['changed_files'])} file(s), deviations: {len(env.get('deviations', []))}")
