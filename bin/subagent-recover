#!/usr/bin/env -S node --experimental-strip-types
/**
 * Trancher une contradiction de reprise, explicitement.
 *
 * Une contradiction entre le registre et le dépôt ferme le run : aucune
 * délégation ne passe tant qu'elle subsiste. Elle ne peut donc pas se résoudre
 * par une délégation ordinaire — ce serait réparer par effet de bord ce qu'on
 * refuse de réparer par heuristique. C'est une action d'opérateur, faite en
 * connaissance de cause.
 *
 *     bin/subagent-recover                      voir les contradictions
 *     bin/subagent-recover <unité> adopt        le worktree est légitime, l'adopter
 *     bin/subagent-recover <unité> integrated   le merge a eu lieu, l'enregistrer
 *     bin/subagent-recover <unité> abandoned    ce travail est abandonné
 *     bin/subagent-recover <unité> discard      retirer le worktree, puis abandonner
 *
 *     bin/subagent-recover cleanup             ce qui est rangeable, et ce qui reste
 *     bin/subagent-recover cleanup --apply     le ranger
 *
 *     bin/subagent-recover report              le relevé terminal du run
 *     bin/subagent-recover report --json       le même, pour une mesure
 *
 *     bin/subagent-recover attempts                        voir les tentatives d'intégration
 *     bin/subagent-recover attempt <id> return-to-lane     clore, l'unité repart en lane
 *     bin/subagent-recover attempt <id> discard-context    retirer un contexte terminé
 *
 * Les tentatives se désignent par leur identifiant durable, jamais par leur
 * unité : plusieurs peuvent s'être succédé pour la même, et un opérateur doit
 * savoir lequel de ces objets il tranche.
 *
 * Chaque résolution prend le bail, agit, puis enregistre le fait accompli —
 * dans cet ordre, comme partout ailleurs. Aucune ne devine : elle applique la
 * décision de celui qui l'a tapée.
 */
import { join } from "node:path";
import { readFileSync, existsSync } from "node:fs";
import { execFileSync } from "node:child_process";

import {
  acquireRunOwnership,
  appendIntegrationEvent,
  appendLaneEvent,
  decideUnderLease,
  LANE_LEDGER_VERSION,
  migrateLaneLedger,
  readLaneEvents,
  readManifest,
  releaseRunOwnership,
  takeOverRun,
} from "../subagent-only/run-manifest.ts";
import { describeConflicts } from "../subagent-only/lane-ledger.ts";
import { observeLanes } from "../subagent-only/lane-observe.ts";
import { isActive } from "../subagent-only/integration-ledger.ts";
import { observeIntegrations } from "../subagent-only/integration-observe.ts";
import { closeAttempt, removeIntegration } from "../subagent-only/integration.ts";
import { applyCleanup, planCleanup } from "../subagent-only/cleanup.ts";
import {
  readGitInvocationCount,
  recordGitInvocation,
} from "../subagent-only/git-probe-counter.ts";
import { buildRunReport, formatRunReport } from "../subagent-only/run-report.ts";
import { validatePlan } from "../subagent-only/work-units.ts";
import {
  abandonLane, confirmIntegrations, isMerged, laneChanges, laneHasDiverged, laneTip, laneUnmergedCommitCount,
  openLanes, removeLane, removeLaneBranch, runBranches,
} from "../subagent-only/worktree.ts";

const RUNS = ".pi-subagent-runs";
const root = process.cwd();
const dir = join(root, RUNS);

/** Une commande git qui répond oui ou non, sans jeter. */
function tryGitRecover(args) {
  try {
    recordGitInvocation();
    execFileSync("git", args, { cwd: root, stdio: "ignore" });
    return true;
  } catch {
    return false;
  }
}

const manifest = readManifest(dir);
if (!manifest) {
  console.error(`aucun run actif dans ${RUNS}/`);
  process.exit(1);
}
const runId = manifest.runId;

/**
 * L'état des lanes, par l'observateur que le runtime utilise.
 *
 * Cette fonction bâtissait sa propre collecte, et elle a divergé : elle n'a
 * jamais reçu `confirmedCommits`, donc elle tenait chaque unité intégrée pour
 * prouvée par sa seule branche. Plus prudent que le runtime, donc invisible — et
 * différent, ce qui est la seule chose qui compte pour un outil censé trancher
 * ce que le runtime refuse.
 */
function etat() {
  const laneRead = readLaneEvents(dir, runId);
  return { laneRead, vu: observeLanes({ root, runId, laneRead }) };
}

/** Sortir si le registre des lanes interdit toute reconstruction. */
function exigerLanes(vu) {
  if (vu.usable) return vu.snapshot;
  console.error(vu.reason);
  process.exit(1);
}

const args = process.argv.slice(2).filter((a) => !a.startsWith("--"));
const [unite, action] = args;

/** La valeur d'une option `--nom valeur`, si elle est là. */
function valeurOption(nom) {
  const i = process.argv.indexOf(nom);
  return i !== -1 ? process.argv[i + 1] : undefined;
}

/**
 * Ce qui a un sens, selon la nature de la contradiction.
 *
 * Afficher les quatre verbes indistinctement invitait des parcours absurdes en
 * plusieurs étapes — un `discard` qui écrit un abandon, puis une réconciliation
 * qui le contredit. Les postconditions refusent déjà les faits faux ; ceci
 * évite d'y arriver.
 */
const SUGGESTIONS = {
  "lane-disparue": ["abandoned"],
  "worktree-orphelin": ["adopt", "discard"],
  // Sans événement, il n'y a pas de base — donc `integrated` serait refusé par
  // sa propre postcondition. La seule résolution exécutable est de retirer la
  // branche parasite, et `--base` permet de reconstruire une provenance quand
  // l'opérateur sait d'où elle part.
  "branche-sans-provenance": ["discard"],
  "integration-non-enregistree": ["integrated"],
  "integration-non-confirmee": ["abandoned"],
  "residu-sale": ["discard"],
  "residu-d-abandon": ["discard"],
  "abandon-contredit-par-git": ["integrated"],
};

/**
 * Un registre amputé ferme l'outil comme il ferme le run.
 *
 * L'outil lisait le compte de lignes illisibles puis continuait : il pouvait
 * annoncer « aucune contradiction » sur une histoire dont il manque des
 * morceaux, et surtout prendre le bail pour ajouter des faits par-dessus. Une
 * porte qui ne vaut que d'un côté n'est pas une porte.
 */
/**
 * Migrer un registre écrit avant que le protocole soit versionné.
 *
 * Ne fait qu'une chose : poser l'en-tête. Elle refuse si une seule ligne n'est
 * pas lisible sous la version courante, parce que la migration ne doit pas
 * décider à la place de l'opérateur ce que devient une ligne qu'elle ne
 * comprend pas — c'est de la provenance, et la deviner reviendrait à réécrire
 * l'histoire du run.
 */
function migrerRegistre() {
  const sessionId = `recover-migrate-${process.pid}`;
  const pris = acquireRunOwnership(dir, runId, sessionId);
  let lease;
  if (pris.ok) {
    lease = pris.lease;
  } else if (pris.kind === "recovery-required") {
    console.log("bail périmé : reprise explicite pour migration");
    lease = takeOverRun(dir, runId, sessionId);
  } else {
    console.error("le run est tenu par une autre session ; migration refusée.");
    process.exit(1);
  }

  try {
    const r = migrateLaneLedger(dir, runId, lease);
    switch (r.status) {
      case "missing":
        console.log("aucun registre : rien à migrer.");
        return;
      case "current":
        console.log(`registre déjà en version ${LANE_LEDGER_VERSION} : rien à faire.`);
        return;
      case "unsupported":
        console.error(`registre en version ${r.version} : cette version n'est pas migrable ici.`);
        console.error(`  ce runtime écrit la version ${LANE_LEDGER_VERSION}.`);
        process.exitCode = 1;
        return;
      case "malformed":
        console.error(`migration impossible : ligne(s) ${r.lines.join(", ")} ne sont pas`);
        console.error(`  lisibles en version ${LANE_LEDGER_VERSION}.`);
        console.error("  la migration pose l'en-tête, elle ne réécrit aucune ligne.");
        process.exitCode = 1;
        return;
      case "migrated":
        console.log(`registre migré en version ${LANE_LEDGER_VERSION} : ${r.events} fait(s) conservé(s).`);
        return;
    }
  } finally {
    releaseRunOwnership(dir, lease);
  }
}

if (process.argv.includes("--migrate-ledger")) {
  migrerRegistre();
  process.exit(process.exitCode ?? 0);
}

/**
 * Un registre d'une autre version n'est pas un registre abîmé.
 *
 * Le confondre ferait proposer de corriger des lignes là où il faut migrer.
 */
function refuserSiAutreVersion(version) {
  if (version === LANE_LEDGER_VERSION) return;
  const trouve = version === undefined ? "aucune version déclarée" : `version ${version}`;
  console.error(`registre d'une autre version : ${trouve}, ce runtime lit ${LANE_LEDGER_VERSION}.`);
  console.error("  ce n'est pas une corruption ; ne pas corriger ses lignes à la main.");
  console.error("  migrer avec : bin/subagent-recover --migrate-ledger");
  process.exit(1);
}

function refuserSiAmpute(lignes) {
  if (lignes.length === 0) return;
  console.error(`registre illisible : ligne(s) ${lignes.join(", ")} de ${runId}-lanes.jsonl`);
  console.error("  aucune action n'est possible tant que ces lignes n'ont pas été corrigées.");
  console.error("  elles ne sont jamais supprimées automatiquement : leur contenu est de");
  console.error("  la provenance, et la deviner reviendrait à réécrire l'histoire du run.");
  process.exit(1);
}

if (!unite) {
  const { laneRead, vu } = etat();
  console.log(`run ${runId} · ${manifest.status}`);
  if (laneRead.version !== LANE_LEDGER_VERSION) {
    const trouve = laneRead.version === undefined ? "aucune version" : `version ${laneRead.version}`;
    console.log(`registre d'une autre version : ${trouve} (ce runtime lit ${LANE_LEDGER_VERSION})`);
    console.log("  migrer avec : bin/subagent-recover --migrate-ledger");
    process.exit(0);
  }
  if (!vu.usable) {
    /*
     * Un registre amputé ne donne aucun bilan — ni ici ni ailleurs. La version
     * précédente en affichait un en le disant « sans preuve », ce qui invitait
     * à le lire quand même.
     */
    console.log(vu.reason);
    process.exit(0);
  }
  const bilan = vu.snapshot.reconciliation;
  console.log(bilan.conflicts.size === 0
    ? "aucune contradiction : le run accepte les délégations."
    : describeConflicts(bilan.conflicts));
  for (const c of bilan.conflicts.values()) {
    const quoi = SUGGESTIONS[c.kind] ?? [];
    if (quoi.length) console.log(`  ${c.workUnitId} → ${quoi.join(" ou ")}`);
  }
  for (const w of bilan.warnings) console.log(`à ranger : ${w.detail}`);
  process.exit(0);
}


// ---------------------------------- les tentatives d'intégration

/**
 * L'état durable des tentatives, croisé au disque.
 *
 * Lu sans le bail : observer n'exige pas la propriété, et un opérateur doit
 * pouvoir regarder avant de décider.
 *
 * La même collecte que le runtime, par le même module : un opérateur et un
 * runtime qui regardent le même disque doivent en conclure le même état. Cet
 * outil lisait le registre des lanes de son côté, sans en vérifier la version ni
 * les lignes abîmées — un registre corrompu fermait donc le run pendant que
 * l'outil calculait tranquillement et acceptait de trancher.
 */
function etatTentatives(laneRead) {
  const lu = laneRead ?? readLaneEvents(dir, runId);
  return { laneRead: lu, vu: observeIntegrations({ root, runDir: dir, runId, laneRead: lu }) };
}

/** Sortir si l'un des deux registres interdit toute reconstruction. */
function exigerObservable(vu) {
  if (vu.usable) return vu.snapshot;
  console.error(vu.reason);
  process.exit(1);
}

/** Ce que l'outil montre : l'observation, sans remède inventé. */
function montrerTentatives() {
  const { facts: attempts, contexts: contextes, reconciliation: bilan } =
    exigerObservable(etatTentatives().vu);
  if (attempts.size === 0 && contextes.length === 0) {
    console.log("aucune tentative d'intégration dans ce run.");
    return;
  }
  const phaseDe = new Map();
  for (const [, v] of bilan.phases) phaseDe.set(v.id, v.phase);
  for (const a of attempts.values()) {
    const etat = !isActive(a)
      ? a.closed ? `close (${a.closed})` : `remplacée par ${a.supersededBy}`
      : (phaseDe.get(a.id) ?? "état indéterminé");
    console.log(`${a.id}`);
    console.log(`  unité      ${a.workUnit}`);
    console.log(`  état       ${etat}`);
    console.log(`  P1         ${a.p1}`);
    console.log(`  P2         ${a.p2}`);
    if (a.committed) console.log(`  M / T      ${a.committed.commit} / ${a.committed.tree}`);
    if (a.recovery) console.log(`  reprise    ${a.recovery.reason}`);
    console.log(`  contexte   ${contextes.includes(a.id) ? "présent" : "absent"}`);
    /*
     * Aucun verbe n'intègre `M`.
     *
     * Le runtime sait déjà faire atterrir un commit vérifié, et lui donner un
     * second chemin créerait deux mécanismes concurrents capables d'intégrer.
     * Pour une tentative prête, la reprise normale reste : lever l'obstacle,
     * puis déléguer sur l'unité — le runtime réessaiera de lui-même.
     */
    if (phaseDe.get(a.id) === "ready-to-land") {
      console.log("  suite      lever l'obstacle, puis worker|reviewer sur l'unité :");
      console.log("             le runtime refera atterrir M lui-même.");
    } else if (isActive(a)) {
      console.log(`  suite      bin/subagent-recover attempt ${a.id} return-to-lane`);
    } else if (contextes.includes(a.id)) {
      console.log(`  suite      bin/subagent-recover attempt ${a.id} discard-context`);
    }
    console.log();
  }
  for (const id of contextes) {
    if (attempts.has(id)) continue;
    console.log(`${id}`);
    console.log("  contexte présent, aucune provenance au registre.");
    console.log("  aucun verbe : un contexte sans provenance ne se clôt pas, il se comprend.");
    console.log();
  }
  if (bilan.conflicts.length > 0) {
    console.log("contradictions :");
    for (const c of bilan.conflicts) console.log(`  ${c.kind} — ${c.detail}`);
  }
}

/** Le plan, tel qu'un opérateur doit le lire avant qu'il agisse. */
function afficherPlan(plan) {
  const rien =
    plan.laneWorktrees.length === 0 &&
    plan.laneBranches.length === 0 &&
    plan.integrationContexts.length === 0;

  console.log("à retirer :");
  if (rien) console.log("  rien");
  for (const u of plan.laneWorktrees) console.log(`  worktree  ${runId}-${u}`);
  for (const u of plan.laneBranches) console.log(`  branche   pi-lane/${runId}-${u}`);
  for (const id of plan.integrationContexts) console.log(`  contexte  ${id}`);

  if (plan.retained.length > 0) {
    console.log();
    console.log("conservé :");
    for (const r of plan.retained) console.log(`  ${r.object}\n    ${r.reason}`);
  }
  return rien;
}

/**
 * Le plan, à partir d'une seule lecture du registre des lanes.
 *
 * Les deux observateurs reçoivent le même snapshot, et un registre de lanes
 * inexploitable arrête tout : un plan bâti sur les événements encore lisibles
 * pourrait supprimer un worktree ou une branche que les lignes illisibles
 * protégeaient.
 */
function planDeNettoyage() {
  const laneRead = readLaneEvents(dir, runId);
  const lanes = observeLanes({ root, runId, laneRead });
  if (!lanes.usable) return { ok: false, reason: lanes.reason };
  const vuT = etatTentatives(laneRead).vu;
  return {
    ok: true,
    plan: planCleanup(
      lanes.snapshot.reconciliation,
      vuT.usable ? vuT.snapshot.reconciliation : undefined,
    ),
    tentativesLisibles: vuT.usable,
    raisonTentatives: vuT.usable ? undefined : vuT.reason,
  };
}

if (args[0] === "report") {
  /*
   * Le relevé, vu de l'opérateur.
   *
   * Une reconstruction, mesurée, puis une projection. Les deux observateurs sont
   * ceux du runtime et reçoivent la même lecture du registre des lanes ; le
   * relevé lui-même ne sonde rien — il reçoit ce qu'ils ont vu.
   *
   * La fenêtre part avant `readLaneEvents` et s'arrête après la seconde
   * réconciliation, `planCleanup` en dehors : le plan est une projection pure,
   * pas une reconstruction, et l'inclure gonflerait `recovery_scan_ms` d'un
   * travail que la mesure ne prétend pas couvrir.
   */
  const debut = performance.now();
  const sondesAvant = readGitInvocationCount();

  const laneRead = readLaneEvents(dir, runId);
  const lanes = observeLanes({ root, runId, laneRead });
  const vuT = lanes.usable ? etatTentatives(laneRead).vu : undefined;

  const metrics = {
    recovery_scan_ms: performance.now() - debut,
    git_probe_count: readGitInvocationCount() - sondesAvant,
  };

  if (!lanes.usable) {
    console.error(lanes.reason);
    process.exit(1);
  }

  const tentatives = vuT?.usable ? vuT.snapshot : undefined;
  const releve = buildRunReport(
    { runId, status: manifest.status },
    lanes.snapshot,
    tentatives,
    planCleanup(lanes.snapshot.reconciliation, tentatives?.reconciliation),
    metrics,
  );

  if (process.argv.includes("--json")) console.log(JSON.stringify(releve, null, 2));
  else console.log(formatRunReport(releve));
  process.exit(0);
}

if (args[0] === "cleanup") {
  /*
   * Le nettoyage : un plan, puis des suppressions, et rien entre les deux.
   *
   * Sans `--apply`, il montre — et il observe sans le bail, parce qu'observer
   * n'exige pas la propriété. C'est le mode par défaut à dessein : une
   * suppression se lit avant de se faire, et le plan dit aussi bien ce qu'il
   * retire que ce qu'il garde, avec la raison de chaque objet gardé.
   *
   * Il ne décide de rien. Les ensembles rangeables viennent des deux
   * réconciliations ; une contradiction non tranchée retient ce qu'elle porte,
   * et c'est aux verbes de recovery de la trancher.
   */
  // `args` a déjà filtré les options : c'est `process.argv` qui les porte.
  const appliquer = process.argv.includes("--apply");

  if (!appliquer) {
    const vu = planDeNettoyage();
    if (!vu.ok) {
      console.error(vu.reason);
      process.exit(1);
    }
    const { plan, tentativesLisibles, raisonTentatives } = vu;
    if (!tentativesLisibles) {
      console.log("registre des tentatives illisible : aucun contexte n'entre dans ce plan.");
      console.log(`  ${raisonTentatives}`);
      console.log();
    }
    const rien = afficherPlan(plan);
    console.log();
    console.log(rien ? "rien à faire." : "relancer avec --apply pour retirer ces objets.");
    process.exit(0);
  }

  /*
   * Sous le bail, le plan se recalcule.
   *
   * Acquérir la propriété sérialise ce qui vient après ; cela ne valide pas un
   * plan bâti quand une autre session pouvait encore rouvrir une lane ou clore
   * une tentative. Pour une écriture de registre, le pire serait un fait faux —
   * refusé par sa garde. Ici, l'effet est une suppression : le plan appliqué
   * doit être celui qu'on vient de lire, et il est affiché juste avant d'agir.
   *
   * Le bail sert aussi à autre chose : retirer un worktree sous une session qui
   * travaille dedans serait un dégât, et la capacité est ce qui dit que
   * personne ne travaille.
   */
  const sessionCleanup = `recover-${process.pid}`;
  let leaseC;
  let bilanCleanup;
  const resultatCleanup = decideUnderLease({
    acquire: () => {
      const pris = acquireRunOwnership(dir, runId, sessionCleanup);
      if (pris.ok) leaseC = pris.lease;
      else if (pris.kind === "recovery-required") {
        console.log("  bail périmé : reprise explicite");
        leaseC = takeOverRun(dir, runId, sessionCleanup);
      } else {
        console.error("  le run est tenu par une autre session ; réessayer plus tard.");
        process.exit(1);
      }
    },
    reread: () => planDeNettoyage(),
    validate: (x) => (x.ok ? null : x.reason),
    act: ({ plan, tentativesLisibles, raisonTentatives }) => {
      if (!tentativesLisibles) {
        console.log("registre des tentatives illisible : aucun contexte n'entre dans ce plan.");
        console.log(`  ${raisonTentatives}`);
        console.log();
      }
      if (afficherPlan(plan)) return;
      bilanCleanup = applyCleanup(root, runId, plan);
    },
    release: () => {
      if (leaseC) releaseRunOwnership(dir, leaseC);
    },
  });

  if (!resultatCleanup.ok) {
    console.error(resultatCleanup.reason);
    process.exit(1);
  }
  if (!bilanCleanup) process.exit(0);

  console.log();
  for (const w of bilanCleanup.removedWorktrees) console.log(`  retiré  worktree ${w}`);
  for (const b of bilanCleanup.removedBranches) console.log(`  retiré  ${b}`);
  for (const c of bilanCleanup.removedContexts) console.log(`  retiré  contexte ${c}`);
  if (bilanCleanup.failures.length > 0) {
    console.log();
    console.log("non retiré :");
    for (const f of bilanCleanup.failures) console.log(`  ${f.object}\n    ${f.reason}`);
    process.exit(1);
  }
  process.exit(0);
}

if (args[0] === "attempts") {
  montrerTentatives();
  process.exit(0);
}

/**
 * Ce qui interdit un verbe, ou null s'il est permis.
 *
 * La même fonction sert au relevé d'avant le bail — pour refuser vite et nommer
 * l'objet — et à la relecture faite sous le bail, qui seule autorise. Deux jeux
 * de règles auraient fini par diverger, et c'est la seconde qui compte.
 */
function refusDeVerbe(verbe, cible, snapshot, lanes) {
  const a = snapshot.facts.get(cible);
  if (!a) {
    return `${cible} n'existe pas au registre des tentatives.\n` +
      "  `bin/subagent-recover attempts` montre celles qui existent.";
  }

  /*
   * Les deux verbes ne sont pas synonymes, et leur domaine ne se recouvre pas.
   *
   * `return-to-lane` clôt une tentative vivante : c'est une décision métier.
   * `discard-context` ne décide rien : il retire l'objet physique d'une
   * tentative que le registre dit déjà terminée. Aucun événement métier n'en
   * sort, parce qu'il n'y a rien de nouveau à raconter.
   */
  if (verbe === "discard-context") {
    if (isActive(a)) {
      return `${cible} est encore vivante : un contexte actif ne se jette pas.\n` +
        "  la clore d'abord, ou la laisser au runtime.";
    }
    if (!snapshot.contexts.includes(cible)) {
      return `${cible} n'a pas de contexte sur le disque : rien à retirer.`;
    }
    return null;
  }

  if (!isActive(a)) return `${cible} est déjà terminée : il n'y a plus de tentative à clore.`;

  if (!tryGitRecover(["-C", root, "cat-file", "-e", `${a.p2}^{commit}`])) {
    return `le travail gelé de ${a.workUnit} (${a.p2.slice(0, 12)}) n'est plus dans le dépôt.\n` +
      "  clore la tentative dirait que l'unité repart dans sa lane, et elle n'a plus\n" +
      "  d'où repartir. C'est une contradiction à comprendre, pas à trancher ici.";
  }

  /*
   * Et la lane doit être un endroit où revenir.
   *
   * `P2` existe ne le prouve pas : tant que le contexte d'intégration est là, il
   * tient cette référence à lui seul. Une lane supprimée sous une tentative
   * vivante donnait donc un `P2` valide, un `CLOSED` écrit, un contexte retiré —
   * et le travail n'était plus désigné que par un SHA dans un JSONL, promis au
   * ramasse-miettes de git.
   *
   * Une seule condition : la réconciliation retire déjà de `openUnits` toute
   * unité en contradiction. Le conflit sert à dire pourquoi, pas à décider.
   */
  if (!lanes.openUnits.has(a.workUnit)) {
    const contradiction = lanes.conflicts.get(a.workUnit);
    return `${a.workUnit} n'a pas de lane où revenir.\n` +
      (contradiction
        ? `  sa lane est en contradiction : ${contradiction.kind} — ${contradiction.detail}\n`
        : "  son registre ne la donne pas ouverte, ou son worktree n'est plus là.\n") +
      `  ${cible} est conservée : tant que la lane n'est pas sûre, son contexte est\n` +
      `  la référence qui protège le travail gelé (${a.p2.slice(0, 12)}).\n` +
      "  trancher d'abord l'état de la lane : bin/subagent-recover";
  }
  return null;
}

if (args[0] === "attempt") {
  const [, cible, verbe] = args;
  const VERBES = new Set(["return-to-lane", "discard-context"]);
  if (!cible || !verbe || !VERBES.has(verbe)) {
    console.error("usage : bin/subagent-recover attempt <id> return-to-lane | discard-context");
    process.exit(1);
  }

  /*
   * Un premier relevé, sans le bail, pour refuser vite et sur le bon objet.
   * Il n'autorise rien : la décision se prendra sur une relecture faite sous la
   * propriété qui l'autorise.
   */
  /*
   * Les lanes d'abord : c'est leur registre qui alimente les deux observateurs,
   * donc c'est lui qui doit nommer la cause quand il est inexploitable.
   * L'inverse marchait — `observeIntegrations` refuse aussi — mais le message
   * venait alors du second lecteur pour un défaut du premier.
   */
  const { laneRead: avantRead, vu: avantLanes } = etat();
  const lanesAvant = exigerLanes(avantLanes).reconciliation;
  const avant = exigerObservable(etatTentatives(avantRead).vu);
  const refusRapide = refusDeVerbe(verbe, cible, avant, lanesAvant);
  if (refusRapide) {
    console.error(refusRapide);
    process.exit(1);
  }

  const sessionTentative = `recover-${process.pid}`;
  let leaseT;
  let echec;
  const resultat = decideUnderLease({
    acquire: () => {
      const pris = acquireRunOwnership(dir, runId, sessionTentative);
      if (pris.ok) leaseT = pris.lease;
      else if (pris.kind === "recovery-required") {
        console.log("  bail périmé : reprise explicite");
        leaseT = takeOverRun(dir, runId, sessionTentative);
      } else {
        console.error("  le run est tenu par une autre session ; réessayer plus tard.");
        process.exit(1);
      }
    },
    /*
     * La relecture qui autorise.
     *
     * Acquérir le bail sérialise les écritures futures ; cela ne valide pas
     * rétroactivement ce qu'on a lu avant. Une autre session a pu, entre le
     * relevé et l'acquisition, clore cette tentative ou abandonner la lane — et
     * elle en avait parfaitement le droit.
     */
    reread: () => {
      const { laneRead, vu } = etat();
      return {
        lanes: exigerLanes(vu).reconciliation,
        snapshot: exigerObservable(etatTentatives(laneRead).vu),
      };
    },
    validate: ({ snapshot, lanes }) => refusDeVerbe(verbe, cible, snapshot, lanes),
    act: ({ snapshot }) => {
      const a = snapshot.facts.get(cible);
      try {
        if (verbe === "discard-context") {
          // Purement physique : le registre dit déjà ce qu'il y avait à dire.
          // `removeIntegration` rend un booléen et ne jette pas ; l'ignorer
          // faisait annoncer un retrait qui n'avait pas eu lieu.
          if (!removeIntegration(root, cible)) {
            throw new Error(
              `le contexte ${cible} n'a pas pu être retiré (worktree verrouillé ?) ; ` +
              "le registre est inchangé, rien n'a été décidé.",
            );
          }
          console.log(`  contexte ${cible} retiré ; le registre est inchangé.`);
        } else {
          closeAttempt(
            cible,
            () =>
              appendIntegrationEvent(
                dir,
                { event: "CLOSED", id: cible, outcome: "returned-to-lane", at: new Date().toISOString() },
                leaseT,
              ),
            (id) => {
              /*
               * La décision durable est passée ; seul le nettoyage physique peut
               * encore échouer. On ne défait surtout pas `CLOSED` — l'état juste
               * est « tentative close, contexte à ranger », un résidu nommé.
               */
              if (!removeIntegration(root, id)) {
                throw new Error(
                  `${cible} est close et ${a.workUnit} repart dans sa lane, mais le contexte ` +
                  `${id} n'a pas pu être retiré (worktree verrouillé ?). C'est un résidu : ` +
                  `\`bin/subagent-recover attempt ${id} discard-context\` une fois débloqué.`,
                );
              }
            },
          );
          console.log(`  ${cible} close : ${a.workUnit} repart dans sa lane.`);
          console.log("  rien n'a été copié du contexte : ce qu'il contenait n'a pas été revu.");
        }
      } catch (e) {
        echec = e instanceof Error ? e.message : String(e);
        console.error(`  échec : ${echec}`);
      }
    },
    release: () => {
      if (leaseT) releaseRunOwnership(dir, leaseT);
    },
  });

  if (!resultat.ok) {
    console.error("  l'état a changé avant que le bail soit obtenu ; rien n'a été décidé.");
    console.error(resultat.reason);
    process.exit(1);
  }
  if (echec) process.exit(1);

  console.log();
  const apres = exigerObservable(etatTentatives().vu).reconciliation;
  console.log(apres.conflicts.length === 0
    ? "aucune contradiction de tentative restante."
    : apres.conflicts.map((c) => `  ${c.kind} — ${c.detail}`).join("\n"));
  process.exit(0);
}

const ACTIONS = new Set(["adopt", "integrated", "abandoned", "discard"]);
if (!action || !ACTIONS.has(action)) {
  console.error(`action attendue : ${[...ACTIONS].join(" | ")}`);
  process.exit(1);
}


/**
 * L'unité appartient-elle au plan gelé ?
 *
 * Ajouter de la provenance à une unité que le plan ne connaît pas la ferait
 * entrer définitivement dans l'histoire du run : un worktree nommé à la main
 * suffirait à inventer une WorkUnit. `discard` reste ouvert aux inconnues,
 * précisément parce que c'est le chemin de nettoyage d'un worktree parasite.
 */
function dansLePlan(u) {
  const chemin = join(dir, `${runId}-plan.json`);
  if (!existsSync(chemin)) return { ok: false, pourquoi: "aucun plan gelé" };
  const [statut, raison, unites] = (() => {
    const r = validatePlan(JSON.parse(readFileSync(chemin, "utf-8")));
    return [r.status, r.reason, r.units];
  })();
  if (statut !== "usable") return { ok: false, pourquoi: `plan ${statut} : ${raison}` };
  return unites.some((x) => x.id === u)
    ? { ok: true }
    : { ok: false, pourquoi: `${u} ne figure pas dans le plan gelé` };
}

const { laneRead, vu: vuLanes } = etat();
refuserSiAutreVersion(laneRead.version);
refuserSiAmpute(laneRead.malformedLines);
const bilan = exigerLanes(vuLanes).reconciliation;
const conflit = bilan.conflicts.get(unite);
if (!conflit) {
  console.error(`${unite} n'est pas en contradiction ; rien à trancher.`);
  process.exit(1);
}

console.log(`${unite} · ${conflit.kind}`);
console.log(`  ${conflit.detail}`);

const suggeres = SUGGESTIONS[conflit.kind] ?? [...ACTIONS];
if (!suggeres.includes(action)) {
  console.error(`  refus : « ${action} » n'a pas de sens pour ${conflit.kind}.`);
  console.error(`  actions possibles ici : ${suggeres.join(", ")}`);
  process.exit(1);
}

const appartenance = dansLePlan(unite);
const horsPlan = !appartenance.ok;
if (action !== "discard" && horsPlan) {
  console.error(`  refus : ${appartenance.pourquoi}.`);
  console.error(`  seul « discard » peut nettoyer une unité hors plan.`);
  process.exit(1);
}

// Prendre le bail, ou le reprendre s'il est périmé — un run à trancher est
// souvent un run dont la session est morte.
const sessionId = `recover-${process.pid}`;
const pris = acquireRunOwnership(dir, runId, sessionId);
let lease;
if (pris.ok) {
  lease = pris.lease;
} else if (pris.kind === "recovery-required") {
  console.log("  bail périmé : reprise explicite");
  lease = takeOverRun(dir, runId, sessionId);
} else {
  console.error("  le run est tenu par une autre session ; réessayer plus tard.");
  process.exit(1);
}

/*
 * Relire après avoir pris le bail.
 *
 * Le conflit a été observé avant l'acquisition : deux processus de résolution
 * pouvaient donc décider sur le même instantané, et le second agir après que le
 * premier a déjà tranché. C'est la discipline de 3b.2 appliquée à son propre
 * outil — observer, acquérir, relire, vérifier, agir, enregistrer.
 */
const { laneRead: apresRead, vu: apresVu } = etat();
if (apresRead.version !== LANE_LEDGER_VERSION) {
  releaseRunOwnership(dir, lease);
  refuserSiAutreVersion(apresRead.version);
}
// Le registre a pu devenir illisible entre l'observation et l'acquisition :
// « observer, acquérir, relire » ne vaut que si la relecture porte sur tout.
if (!apresVu.usable) {
  releaseRunOwnership(dir, lease);
  console.error(apresVu.reason);
  process.exit(1);
}
const apresBail = apresVu.snapshot.reconciliation;
const encore = apresBail.conflicts.get(unite);
if (!encore) {
  console.log("  la contradiction a disparu entre-temps : rien à faire.");
  releaseRunOwnership(dir, lease);
  process.exit(0);
}
if (encore.kind !== conflit.kind) {
  console.error(`  la contradiction a changé (${conflit.kind} → ${encore.kind}) : relancer.`);
  releaseRunOwnership(dir, lease);
  process.exit(1);
}

/*
 * Vérifier la postcondition avant d'écrire le fait.
 *
 * L'outil prétend enregistrer ce qui s'est passé ; sans cette vérification il
 * le fabriquerait. Écrire `INTEGRATED` sur une unité que git ne montre pas
 * intégrée satisferait ses dépendantes sur un merge qui n'a jamais eu lieu.
 */
// La base de la lane, pas celle du run : la seconde donne la mauvaise réponse
// dès qu'une autre unité a été intégrée entre-temps.
const evenements = readLaneEvents(dir, runId).events;
const ouverture = evenements.find((e) => e.event === "OPENED" && e.work_unit === unite);
const base = ouverture?.base;
if (action === "integrated" && !(base && isMerged(root, `${runId}-${unite}`, base))) {
  console.error("  refus : git ne montre aucune intégration pour cette unité.");
  console.error("  « integrated » enregistre un merge, il ne le fabrique pas.");
  releaseRunOwnership(dir, lease);
  process.exit(1);
}
if (action === "abandoned" && base && isMerged(root, `${runId}-${unite}`, base)) {
  console.error("  refus : git montre cette unité comme intégrée.");
  releaseRunOwnership(dir, lease);
  process.exit(1);
}

/*
 * `adopt` veut dire « ce worktree existe et je lui donne sa provenance ».
 * L'écrire sans worktree fabriquerait une ouverture qui n'a jamais eu lieu.
 */
if (action === "adopt" && !openLanes(root).includes(`${runId}-${unite}`)) {
  console.error("  refus : aucun worktree à adopter pour cette unité.");
  releaseRunOwnership(dir, lease);
  process.exit(1);
}

/*
 * Un `discard` ordinaire écrit un abandon. Si git montre l'intégration, ce
 * serait un fait faux — que la réconciliation suivante signalerait, après
 * l'avoir inscrit.
 */
if (
  action === "discard" && conflit.kind !== "residu-sale" &&
  base && isMerged(root, `${runId}-${unite}`, base)
) {
  console.error("  refus : git montre cette unité comme intégrée ; « integrated » convient.");
  releaseRunOwnership(dir, lease);
  process.exit(1);
}

/*
 * Un worktree sale porte du travail qu'on s'apprête à détruire. La commande le
 * montre et demande une intention plus forte que le choix d'un verbe : une
 * perte irréversible ne doit pas tenir à une faute de frappe.
 */
if (action === "discard") {
  const perdus = laneChanges(root, `${runId}-${unite}`);
  if (perdus.length > 0) {
    console.log(`  ${perdus.length} fichier(s) seront perdus :`);
    for (const f of perdus) console.log(`    ${f}`);
    if (!process.argv.includes("--force")) {
      console.error("  ajouter --force pour confirmer cette suppression.");
      releaseRunOwnership(dir, lease);
      process.exit(1);
    }
  }

  /*
   * Une branche peut être la seule copie durable de commits que laneChanges()
   * ne voit plus quand le worktree a disparu. Toute suppression de branche hors
   * provenance / hors plan a donc sa propre confirmation.
   */
  const supprimeBranche = conflit.kind === "branche-sans-provenance" || horsPlan;
  if (supprimeBranche) {
    const n = laneUnmergedCommitCount(root, `${runId}-${unite}`);
    const tip = laneTip(root, `${runId}-${unite}`);
    if (n === undefined || !tip) {
      console.error("  refus : impossible d'établir l'état de la branche à supprimer.");
      releaseRunOwnership(dir, lease);
      process.exit(1);
    }
    recordGitInvocation();
    const head = execFileSync("git", ["rev-parse", "HEAD"], { cwd: root, encoding: "utf-8" }).trim();
    /*
     * Même quand tous les commits de la branche sont déjà dans HEAD, un tip
     * différent de HEAD reste une pièce de provenance : le supprimer ferait
     * disparaître la seule ref qui permet encore d'expliquer cette histoire.
     */
    if (n > 0 || tip !== head) {
      if (n > 0) {
        console.log(`  branche ${tip.slice(0, 12)} : ${n} commit(s) non intégré(s) seront perdus.`);
      } else {
        console.log(
          `  branche ${tip.slice(0, 12)} déjà contenue dans HEAD : sa suppression ` +
          "effacera la dernière ref de cette provenance.",
        );
      }
      if (!process.argv.includes("--force")) {
        console.error("  ajouter --force pour confirmer cette suppression de provenance.");
        releaseRunOwnership(dir, lease);
        process.exit(1);
      }
    }
  }
}

let erreurAction;
try {
  const at = new Date().toISOString();
  switch (action) {
    case "adopt": {
      /*
       * Une ouverture porte sa base, sinon elle prépare le conflit de demain :
       * sans base, l'unité travaillera, sera mergée, et la réconciliation
       * suivante refusera de confirmer son intégration.
       *
       * Pour l'orphelin ordinaire — la fenêtre entre `git worktree add` et
       * l'écriture de l'ouverture — le worker n'a rien commité, donc le sommet
       * de la branche est un point de départ défendable. Une branche divergée a
       * une histoire qu'on ne sait pas situer : l'opérateur donne la base ou
       * l'outil refuse de prétendre qu'il sait.
       */
      /*
       * Une base fournie doit être vraie.
       *
       * Elle est écrite dans le registre et sert ensuite à décider si l'unité
       * est intégrée. Une valeur inexistante ou étrangère à la lane produirait
       * une réponse arbitraire d'`isMerged`, et ce serait pire que le conflit
       * qu'on tranche — l'outil aurait inscrit une provenance fausse au lieu de
       * refuser d'en inventer une.
       */
      const donnee = valeurOption("--base");
      if (donnee) {
        const existe = tryGitRecover(["rev-parse", "--verify", `${donnee}^{commit}`]);
        if (!existe) {
          console.error(`  refus : ${donnee} n'est pas un commit de ce dépôt.`);
          releaseRunOwnership(dir, lease);
          process.exit(1);
        }
        const dansLaLane = tryGitRecover(
          ["merge-base", "--is-ancestor", donnee, `pi-lane/${runId}-${unite}`],
        );
        if (!dansLaLane) {
          console.error(`  refus : ${donnee} n'est pas un ancêtre de la branche de ${unite}.`);
          console.error("  une base doit être un point de départ de cette lane, pas un commit quelconque.");
          releaseRunOwnership(dir, lease);
          process.exit(1);
        }
      }
      let baseAdoptee = donnee;
      if (!baseAdoptee) {
        if (laneHasDiverged(root, `${runId}-${unite}`)) {
          console.error("  refus : cette lane a une histoire propre, sa base est inconnue.");
          console.error("  fournir « --base <sha> » pour l'adopter en connaissance de cause.");
          releaseRunOwnership(dir, lease);
          process.exit(1);
        }
        baseAdoptee = laneTip(root, `${runId}-${unite}`);
      }
      if (!baseAdoptee) {
        console.error("  refus : aucune base déterminable pour cette lane.");
        releaseRunOwnership(dir, lease);
        process.exit(1);
      }
      appendLaneEvent(dir, { event: "OPENED", work_unit: unite, at, base: baseAdoptee }, lease);
      console.log(`  adoptée : ouverte au registre, base ${baseAdoptee.slice(0, 12)}`);
      break;
    }
    case "integrated":
      /*
       * Sans `integration_commit`, délibérément.
       *
       * Le commit qui porte l'intégration n'est pas observable ici : `isMerged`
       * établit que la branche est dans HEAD, pas lequel des commits de HEAD l'y
       * a mise. Le reconstituer serait le fabriquer, et cet outil enregistre ce
       * qui s'est passé. L'unité reste donc prouvée par sa branche, ce qui est
       * vrai — et sa branche n'est pas supprimable, ce qui est la conséquence.
       */
      appendLaneEvent(dir, { event: "INTEGRATED", work_unit: unite, at }, lease);
      console.log("  enregistrée comme intégrée");
      console.log("  sa branche reste sa preuve : ne pas la supprimer");
      break;
    case "abandoned": {
      /*
       * Enregistrer l'abandon **et** ranger le worktree.
       *
       * Le verbe n'écrivait que l'événement. La réconciliation voit alors une
       * unité abandonnée dont le worktree est encore là — `residu-d-abandon`,
       * une contradiction qui ferme le run au tour suivant. L'outil créait donc
       * le problème qu'il venait résoudre, une contradiction plus loin.
       *
       * La branche, elle, survit : elle porte le travail abandonné, et c'est la
       * seule chose qui le désigne encore.
       */
      abandonLane(
        root,
        `${runId}-${unite}`,
        () => appendLaneEvent(
          dir, { event: "ABANDONED", work_unit: unite, at, reason: conflit.kind }, lease),
        (r, id) => (openLanes(r).includes(id) ? removeLane(r, id) : true),
      );
      console.log("  enregistrée comme abandonnée, worktree rangé");
      console.log(`  sa branche est conservée : elle porte le travail (${
        laneTip(root, `${runId}-${unite}`)?.slice(0, 12) ?? "aucun commit"})`);
      break;
    }
    case "discard": {
      /*
       * Une branche parasite se supprime, elle ne s'abandonne pas.
       *
       * `removeLane` ne retire que le worktree — la branche survit par contrat,
       * puisqu'elle porte le travail. Pour une branche sans provenance et sans
       * worktree, il ne supprimait donc pas l'objet qui provoque le conflit, et
       * l'`ABANDONED` écrit ensuite masquait la branche en donnant au registre
       * une unité qu'il ne connaissait pas. Un fait inventé pour faire taire un
       * symptôme.
       */
      if (conflit.kind === "branche-sans-provenance") {
        const tip = laneTip(root, `${runId}-${unite}`);
        console.log(`  branche parasite ${tip ? tip.slice(0, 12) : "?"} : suppression`);
        if (!removeLaneBranch(root, `${runId}-${unite}`, process.argv.includes("--force"))) {
          throw new Error("git a refusé de supprimer la branche parasite");
        }
        console.log("  aucun événement écrit : le registre n'a jamais connu cette unité");
        break;
      }
      // L'effet d'abord, le fait ensuite — comme partout.
      const retire = removeLane(root, `${runId}-${unite}`);
      if (!retire) throw new Error("le worktree attendu n'a pas pu être retiré");
      console.log("  worktree retiré");

      /*
       * Une unité hors plan n'entre jamais dans la provenance. `discard` est
       * seulement son chemin de nettoyage : worktree + branche, puis zéro fait.
       */
      if (horsPlan) {
        if (!removeLaneBranch(root, `${runId}-${unite}`, process.argv.includes("--force"))) {
          throw new Error("le worktree a été retiré mais la branche parasite subsiste");
        }
        console.log("  aucun événement écrit : l'unité ne figure pas dans le plan gelé");
        break;
      }
      /*
       * Un résidu sale porte du travail non intégré **en plus** d'un fait
       * INTEGRATED déjà enregistré et confirmé par git. Retirer le worktree
       * supprime ce surplus ; écrire ABANDONED par-dessus dirait que l'unité a
       * été abandonnée alors que son travail est bel et bien dans le dépôt.
       */
      if (conflit.kind === "residu-sale") {
        console.log("  le fait INTEGRATED est conservé : seul le surplus est retiré");
        break;
      }
      if (conflit.kind === "residu-d-abandon") {
        console.log("  le fait ABANDONED existe déjà : seul le résidu est retiré");
        break;
      }
      appendLaneEvent(dir, { event: "ABANDONED", work_unit: unite, at, reason: "discard" }, lease);
      console.log("  enregistrée comme abandonnée");
      break;
    }
  }
} catch (e) {
  erreurAction = e instanceof Error ? e.message : String(e);
  console.error(`  échec : ${erreurAction}`);
} finally {
  releaseRunOwnership(dir, lease);
}

if (erreurAction) process.exit(1);

const apres = exigerLanes(etat().vu).reconciliation;
console.log();
console.log(apres.conflicts.size === 0
  ? "aucune contradiction restante : le run accepte les délégations."
  : describeConflicts(apres.conflicts));
