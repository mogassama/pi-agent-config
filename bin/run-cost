#!/usr/bin/env python3
"""
run-cost — où vont les tokens d'un run : la grille de coût adjugée, coupée au plan terminal, et sa décomposition.

  bin/run-cost <runs> <sessions> [--run <runId>] [--session <fichier>]… [--coupure auto|aucune|<ISO>]
               [--json <fichier>] [--tours] [--cycles] [--postes]

  <runs>      le `.pi-subagent-runs` du dépôt, ou sa copie relevée
  <sessions>  le dossier des sessions pi de l'orchestrateur pour ce dépôt (*.jsonl)
  --run       le run retenu, quand le dossier en contient plusieurs
  --session   une session retenue (répétable) ; sinon toutes celles du dossier, qui doivent toutes
              appartenir au run
  --coupure   auto (défaut) : l'instant où le plan gelé devient terminal, relu sur le registre des lanes
              avec le prédicat de subagent-only/terminal.ts ; aucune : pas de coupure ; ou un instant ISO
  --json      écrit aussi la grille en JSON
  --tours     ajoute la décomposition tour par tour de chaque délégation (lot ITE, P1 ; adjudication
              Q4 du plan P1) : contexte relevé à chaque tour, appels par tour, et, marquée [estimé],
              la résidence des résultats d'outils par nature. La transcription d'un enfant sert alors
              aux totaux : elle est lue sans omission (une ligne illisible refuse, fichier et ligne
              nommés), et la somme de ses tours doit ÉGALER le total de l'artefact, sinon refus nommé.
  --cycles    ajoute les cycles worker → reviewer → reprise de chaque unité, avant coupure (LOT-REPRISES,
              R3) : workers initiaux et de reprise, reviewers, et la cause de chaque reprise, lue dans
              cet ordre — registres (lanes, délégations), `policy_blockers` structurés de la porte
              (`details.integration_gate` des résultats `task` de la session), verdict structuré de la
              revue. Une cause non démontrable s'écrit `unknown`. Plus les compteurs : porte
              scope-breach et open-risks, approved avec risque ouvert, refus REVIEW_APPROVED_WITH_OPEN_RISKS
              et WRITE_OUTSIDE_SCOPE relevés dans les transcriptions (lues sans omission), refus de plan
              structurés (`details.plan_refusal`).
  --postes    ajoute les postes de LOT-EFFICACITÉ (M) : les règles D1 et D3 adjugées au diagnostic,
              versionnées sans changement, et les compteurs des leviers.
              D1 — chaque appel de l'orchestrateur avant coupure dans UNE catégorie, décidée sur ses
              outils et leurs résultats : planification initiale, refus R1-a, réécriture après refus,
              dispatch/délégation, traitement des retours, intégration / portes, finalisation avant T,
              autre / unknown (listé appel par appel, jamais réaffecté).
              D3 — chaque tour de chaque délégation dans UNE catégorie primaire (lecture, edit/write,
              test, environnement, git, submit, mixed/other) ; chaque tour `test` dans une classe :
              découverte / correction de la commande, tests légitimes après modification, réexécution
              liée à un échec, validation finale. Un tour multi-outils n'est jamais compté deux fois.
              Rapprochements : somme des catégories D1 = orchestrateur avant coupure (et même nombre
              d'appels) ; somme des tours de chaque transcription = total de sa délégation. Leur somme
              absolue doit valoir 0, sinon code 1. Une transcription absente : poste non établi, listé,
              jamais 0. Une ligne JSONL illisible refuse, fichier et ligne nommés.
              Compteurs, lus dans les seules traces structurées du relevé, jamais dans l'environnement
              des enfants. Trace absente de tout le relevé : « absent » ; absente pour une partie des
              délégations, ou contradictoire : « non établi » — jamais 0 par défaut. Une trace ne se
              compte que valide et rattachée à sa délégation (run, séquence, rôle, unité ; provenance :
              run, planHash, unité, séquence, arbre, fichiers) ; chaque submit needs_rework ou blocked,
              apparié par toolCallId, doit porter une observation details.inspection cohérente, sinon
              kept_inspectes_par_injection n'est pas établi (séquence et toolCallId nommés).
                kept_derives      chemins, somme sur les unités des `derived` de <runId>-kept.json,
                                  rapproché de `details.plan_kept` (une discordance : non établi) ;
                                  un chemin compte une fois par unité (le kept est sans doublon).
                kept_retires      entrées `dropped` de <runId>-kept.json, une par (unité, chemin).
                fichiers_injectes fichiers, `injection.provenance.files` de <runId>-<NN>-transmis.json,
                                  sur les revues de lane avant coupure ; une injection par délégation.
                octets_injectes   octets bruts injectés, `injection.octets_injectes` des mêmes traces.
                relectures_injectees  appels `read` (tool_execution_start) d'une revue dont le chemin,
                                  résolu contre le cwd de sa session, est un fichier qui lui a été
                                  injecté, dans la lane ; chaque appel compte (deux plages : deux
                                  relectures) ; une lecture à la racine du dépôt n'en est pas une.
                kept_inspectes_par_injection  paires (délégation, kept) distinctes portées par
                                  `par_injection` de `details.inspection` des submits bloquants, chacune
                                  validée : injection.etat = valide, kept dans la provenance transmise,
                                  contrôle ok, blob lu = attendu = transmis ; un kept observé à deux
                                  submits de la même revue compte une fois.
                contrat_test      la décision sur test_command (absent, ignore, transmis) et ce que le
                                  premier writer de lane avant coupure a reçu (etablie, declaree,
                                  aucune), lus dans le `test_contract` de sa trace transmis.json.
                tours_decouverte_test  tours D3 « découverte / correction de la commande » de ce
                                  premier writer ; établi seulement s'il porte sa trace test_contract.
                tours_environnement    tours D3 « environnement » du même writer, même condition.

Entrées sans ambiguïté (adjudication ITE-1, P1-0). Sans sélection explicite : exactement un run dans
<runs>, son plan `<runId>-plan.json`, et des sessions qui mentionnent toutes ce run et lui seul ;
sinon PRÉCONDITION nommée. Jamais « le dernier plan », jamais l'agrégat des registres de plusieurs
runs ni de toutes les sessions d'un dossier. L'empreinte du plan est vérifiée contre le `planHash`
du manifeste actif ou archivé du run. Une ligne JSONL illisible dans un registre ou une session qui
sert aux totaux refuse, fichier et ligne nommés — elle n'est jamais omise. La sortie dit le run, le
plan et les sessions retenus, et comment ils l'ont été.

Lot ITE, P1-0 (adjudication ITE Q-F, Q-N). Deux familles de nombres, et elles ne se mélangent jamais :

  RELEVÉS     les tokens facturés, tels que pi les écrit : `usage` de chaque message assistant de
              l'orchestrateur, `usage` de chaque artefact de délégation. Même méthode que la baseline
              fonctionnelle (analyse-qd.py) : total = entrée + cache relu + cache écrit + sortie.
              Coupés au plan terminal : AVANT (le coût d'obtenir le travail) et APRÈS (la dérive).
  ESTIMATIONS marquées [estimé] : la part de chaque nature de résultat d'outil dans le contexte de
              l'orchestrateur, en tokens ≈ caractères / 4, et sa résidence — chaque résultat est relu
              à chaque appel suivant jusqu'à la prochaine compaction. Elles disent OÙ chercher ; elles
              ne remplacent jamais un relevé.

Une délégation compte AVANT si elle a commencé avant la coupure ; un appel de l'orchestrateur, si son
horodatage la précède. Rien ici n'écrit, rien ne lance git. Code 0 ; 2 sur une précondition ; 1 si un
rapprochement de --postes n'est pas nul.
"""
import fnmatch
import glob
import hashlib
import json
import os
import re
import statistics as st
import sys
from datetime import datetime

BUNDLE = {"INSTRUCTIONS.md", "ARCHITECTURE.md", "DESIGN.md", "CONVENTIONS.md"}


RUN_ID = re.compile(r"^([0-9a-f]{16})-")


def lire_json(p):
    with open(p, encoding="utf-8") as f:
        return json.load(f)


def lire_octets(p):
    with open(p, "rb") as f:
        return f.read()


class Refus(Exception):
    """Une précondition : le relevé ne se fait pas, et la raison est nommée."""


def jsonl(p):
    """Un JSONL qui sert aux totaux : une ligne illisible refuse, fichier et ligne nommés."""
    out = []
    with open(p, encoding="utf-8") as f:
        for n, ligne in enumerate(f, 1):
            ligne = ligne.strip()
            if not ligne:
                continue
            try:
                out.append(json.loads(ligne))
            except ValueError:
                raise Refus(f"ligne JSONL illisible : {p}:{n}")
    return out


def jsonl_estime(p):
    """Un transcript d'enfant, lu pour les seules estimations : une ligne illisible y est comptée, pas refusée."""
    out, illisibles = [], 0
    with open(p, encoding="utf-8") as f:
        for ligne in f:
            ligne = ligne.strip()
            if not ligne:
                continue
            try:
                out.append(json.loads(ligne))
            except ValueError:
                illisibles += 1
    return out, illisibles


def ts(x):
    if isinstance(x, (int, float)):
        return x / 1000.0
    return datetime.fromisoformat(str(x).replace("Z", "+00:00")).timestamp()


def ctx(u):
    return (u.get("input") or 0) + (u.get("cacheRead") or 0) + (u.get("cacheWrite") or 0)


def tot(u):
    return ctx(u) + (u.get("output") or 0)


def med(v):
    return int(st.median(v)) if v else 0


def texte(contenu):
    if isinstance(contenu, str):
        return contenu
    return "".join(x.get("text", "") for x in (contenu or []) if isinstance(x, dict))


# ------------------------------------------------------------------ sélection : run, plan, sessions

def runs_du_dossier(runs):
    """Les runs dont le dossier porte une trace : fichiers préfixés, manifeste actif."""
    ids = set()
    for nom in os.listdir(runs):
        m = RUN_ID.match(nom)
        if m:
            ids.add(m.group(1))
    actif = os.path.join(runs, "active-run.json")
    if os.path.isfile(actif):
        try:
            rid = lire_json(actif).get("runId")
        except ValueError:
            raise Refus(f"manifeste illisible : {actif}")
        if isinstance(rid, str) and re.fullmatch(r"[0-9a-f]{16}", rid):
            ids.add(rid)
    return sorted(ids)


def choisir_run(runs, explicite):
    ids = runs_du_dossier(runs)
    if explicite:
        if explicite not in ids:
            raise Refus(f"le run {explicite} n'a aucune trace dans {runs} (runs présents : {', '.join(ids) or 'aucun'})")
        return explicite, "explicite (--run)"
    if len(ids) != 1:
        raise Refus(f"{len(ids)} runs dans {runs} ({', '.join(ids) or 'aucun'}) : en désigner un avec --run")
    return ids[0], "seul run du dossier"


def manifeste_du_run(runs, run_id):
    actif = os.path.join(runs, "active-run.json")
    archive = os.path.join(runs, f"{run_id}-run.json")
    for chemin, nature in ((actif, "actif"), (archive, "archivé")):
        if os.path.isfile(chemin):
            try:
                m = lire_json(chemin)
            except ValueError:
                raise Refus(f"manifeste illisible : {chemin}")
            if m.get("runId") == run_id:
                return m, nature
    raise Refus(f"aucun manifeste, actif ou archivé, pour {run_id} dans {runs}")


def plan_verifie(runs, run_id):
    """Le plan gelé du run, empreinte vérifiée contre le planHash de son manifeste."""
    manifeste, nature = manifeste_du_run(runs, run_id)
    chemin = os.path.join(runs, f"{run_id}-plan.json")
    if not os.path.isfile(chemin):
        raise Refus(f"plan gelé absent : {chemin}")
    brut = lire_octets(chemin)
    empreinte = hashlib.sha256(brut).hexdigest()[:16]
    attendu = manifeste.get("planHash")
    if not attendu:
        raise Refus(f"le manifeste {nature} de {run_id} n'attache aucun plan (planHash absent)")
    if empreinte != attendu:
        raise Refus(f"plan {chemin} : empreinte {empreinte} ≠ planHash {attendu} du manifeste {nature}")
    try:
        doc = json.loads(brut.decode("utf-8"))
    except ValueError:
        raise Refus(f"plan illisible : {chemin}")
    unites = [str(u.get("id", "")).strip() for u in doc.get("work_units", []) if isinstance(u, dict)]
    avec_du = any(isinstance(u, dict) and "design_update" in u for u in doc.get("work_units", []))
    return unites, avec_du, f"{os.path.basename(chemin)} · planHash {attendu} vérifié (manifeste {nature})"


def choisir_sessions(sessions, run_id, autres_runs, explicites):
    fichiers = sorted(explicites) if explicites else sorted(
        glob.glob(os.path.join(sessions, "*.jsonl")))
    if not fichiers:
        raise Refus(f"aucune session dans {sessions}")
    etrangeres = []
    for f in fichiers:
        if not os.path.isfile(f):
            raise Refus(f"session désignée introuvable : {f}")
        vu_run, vu_autre = False, False
        with open(f, encoding="utf-8", errors="replace") as contenu:
            for ligne in contenu:
                vu_run = vu_run or run_id in ligne
                vu_autre = vu_autre or any(r in ligne for r in autres_runs)
        if not vu_run or vu_autre:
            etrangeres.append(os.path.basename(f))
    if etrangeres:
        raise Refus(
            f"session(s) étrangère(s) au run {run_id} : {', '.join(etrangeres)}")
    mode = "explicites (--session)" if explicites else \
        "toutes les sessions du dossier, chacune attribuée au run"
    return fichiers, mode


# ------------------------------------------------------------------ registre, coupure

def instant_terminal(evenements, unites, avec_du):
    """Le premier préfixe du registre où chaque unité porte un INTEGRATED final sur sa lane courante."""
    etats = {}
    for e in evenements:
        u, lane = e.get("work_unit"), e.get("lane") or f"v1:{e.get('work_unit')}"
        cour = etats.get(u)
        if e.get("event") == "OPENED":
            etats[u] = {"lane": lane, "etat": "ouverte", "status": False}
        elif e.get("event") == "INTEGRATED" and (cour is None or cour["lane"] == lane):
            etats[u] = {"lane": lane, "etat": "integree" if not cour or cour["etat"] != "abandonnee" else "abandonnee",
                        "status": e.get("status") is not None}
        elif e.get("event") == "ABANDONED" and (cour is None or cour["lane"] == lane):
            etats[u] = {"lane": lane, "etat": "abandonnee", "status": False}
        if unites and all(etats.get(x, {}).get("etat") == "integree" and (etats[x]["status"] or not avec_du)
                          for x in unites):
            return e.get("at")
    return None


# ------------------------------------------------------------------ orchestrateur

def classer(outil, args, racine_lanes=".git/pi-lanes"):
    """La nature d'un résultat d'outil de l'orchestrateur."""
    if outil == "task":
        return "retour de délégation"
    if outil == "bash":
        return "bash"
    if outil in ("read", "grep", "find", "ls"):
        chemin = str((args or {}).get("path") or "")
        if racine_lanes in chemin:
            return f"{outil} · lane"
        if ".pi-subagent-runs" in chemin:
            return f"{outil} · registres/artefacts"
        if os.path.basename(chemin) in BUNDLE:
            return f"{outil} · bundle"
        return f"{outil} · dépôt"
    return outil or "?"


def orchestrateur(fichiers):
    appels, resultats, compactions, args_par_id = [], [], [], {}
    for p in fichiers:
        for e in jsonl(p):
            t = e.get("type")
            if t == "compaction":
                compactions.append(ts(e.get("timestamp")))
            if t != "message":
                continue
            m = e.get("message") or {}
            if m.get("role") == "assistant":
                u = m.get("usage") or {}
                if tot(u) > 0:
                    sortie_texte = sum(len(x.get("text", "")) for x in m.get("content") or [] if isinstance(x, dict) and x.get("type") == "text")
                    appels.append({"t": ts(e.get("timestamp")), "u": u, "texte": sortie_texte})
                for x in m.get("content") or []:
                    if isinstance(x, dict) and x.get("type") == "toolCall":
                        args_par_id[x.get("id")] = (x.get("name"), x.get("arguments") or {})
            elif m.get("role") == "toolResult":
                nom, args = args_par_id.get(m.get("toolCallId"), (m.get("toolName"), {}))
                corps = texte(m.get("content"))
                resultats.append({
                    "t": ts(e.get("timestamp")), "outil": nom or m.get("toolName"), "args": args,
                    "chars": len(corps), "empreinte": hashlib.sha256(corps.encode("utf-8")).hexdigest()[:16],
                    "chemin": str((args or {}).get("path") or ""),
                })
    return appels, resultats, sorted(compactions)


def residence(r, appels, compactions):
    """Combien d'appels suivants relisent ce résultat avant la prochaine compaction."""
    fin = next((c for c in compactions if c > r["t"]), float("inf"))
    return sum(1 for a in appels if r["t"] < a["t"] < fin)


# ------------------------------------------------------------------ délégations

def delegations(runs, run_id):
    chemin = os.path.join(runs, f"{run_id}-delegations.jsonl")
    journal = [d for d in jsonl(chemin) if "seq" in d] if os.path.isfile(chemin) else []
    lignes = []
    for d in journal:
        nom = os.path.basename(d.get("artifact") or "")
        if not nom.startswith(f"{run_id}-"):
            raise Refus(f"{chemin} : délégation #{d.get('seq')} pointe un artefact d'un autre run ({nom})")
        art = os.path.join(runs, nom)
        if not os.path.isfile(art):
            raise Refus(f"artefact absent : {art} (délégation #{d.get('seq')})")
        try:
            j = lire_json(art)
        except ValueError:
            raise Refus(f"artefact illisible : {art}")
        u = j.get("usage") or {}
        env = j.get("envelope") or {}
        payload = env.get("payload") or {}
        outils, lectures = {}, {}
        tr = art[:-5] + ".jsonl" if art.endswith(".json") else ""
        if tr and os.path.isfile(tr):
            evenements, _ = jsonl_estime(tr)
            for e in evenements:
                if e.get("type") == "tool_execution_start":
                    outils[e.get("toolName")] = outils.get(e.get("toolName"), 0) + 1
                    if e.get("toolName") == "read":
                        c = str((e.get("args") or {}).get("path") or "")
                        lectures[c] = lectures.get(c, 0) + 1
        lignes.append({
            "seq": d.get("seq"), "at": d.get("at"), "role": d.get("role"), "unite": d.get("work_unit"),
            "artifact_nom": nom,
            "tours": j.get("turns") or 0, "injecte": j.get("injectedTokens"), "duree_s": round((j.get("durationMs") or 0) / 1000),
            "usage": {k: u.get(k) or 0 for k in ("input", "cacheRead", "cacheWrite", "output")}, "total": tot(u),
            "part_cache": round((u.get("cacheRead") or 0) / tot(u), 3) if tot(u) else 0,
            "verdict": (payload.get("verdict") or env.get("status")) if d.get("role") == "reviewer" else env.get("status"),
            "constats": [f.get("severity") for f in payload.get("findings") or [] if isinstance(f, dict)],
            "outils": outils, "relectures": {c: n for c, n in lectures.items() if n > 1},
            "echec": d.get("failure"),
        })
    return lignes


# ------------------------------------------------------------------ tours (--tours)

def tours_de(transcription, total_artefact, etiquette):
    """
    La décomposition tour par tour d'une délégation, depuis sa transcription.

    RELEVÉ : l'`usage` de chaque message assistant (événement `message_end`), dans l'ordre ; sa
    somme doit égaler le total de l'artefact, qui est ce que la grille compte — sinon refus nommé.
    ESTIMÉ : la taille des résultats d'outils (caractères / 4) et leur résidence, c'est-à-dire le
    nombre de tours qui les relisent ensuite.
    """
    if not os.path.isfile(transcription):
        raise Refus(f"{etiquette} : transcription absente ({transcription}) — --tours ne compte pas sans elle")
    evenements = jsonl(transcription)
    tours, items, appels_par_id = [], [], {}
    for e in evenements:
        if e.get("type") != "message_end":
            continue
        m = e.get("message") or {}
        role = m.get("role")
        if role == "assistant":
            u = m.get("usage") or {}
            appels = [x for x in m.get("content") or [] if isinstance(x, dict) and x.get("type") == "toolCall"]
            tours.append({"contexte": ctx(u), "sortie": u.get("output") or 0, "total": tot(u),
                          "appels": [x.get("name") for x in appels]})
            for x in appels:
                appels_par_id[x.get("id")] = (x.get("name"), x.get("arguments") or {})
        elif role == "toolResult":
            nom, args = appels_par_id.get(m.get("toolCallId"), (m.get("toolName"), {}))
            items.append((len(tours), classer(nom, args), len(texte(m.get("content"))) // 4))
    releve = sum(t["total"] for t in tours)
    if releve != total_artefact:
        raise Refus(f"{etiquette} : la somme des tours de {os.path.basename(transcription)} ({releve}) "
                    f"n'égale pas le total de l'artefact ({total_artefact})")
    natures = {}
    for (apparu, nature, tokens) in items:
        relu = sum(1 for i in range(apparu, len(tours)))
        x = natures.setdefault(nature, {"n": 0, "tokens": 0, "relus": 0})
        x["n"] += 1; x["tokens"] += tokens; x["relus"] += tokens * relu
    un_seul = sum(1 for t in tours[1:] if len(t["appels"]) == 1)
    return {"tours": len(tours), "releve": releve, "contextes": [t["contexte"] for t in tours],
            "appels_par_tour": [len(t["appels"]) for t in tours], "tours_a_un_seul_appel": un_seul,
            "natures_estime": natures}


def imprimer_tours(runs, dl, avant):
    print("\n== TOURS PAR DÉLÉGATION — RELEVÉ (usage par tour, rapproché de l'artefact) ; [estimé] marqué")
    sortie = []
    for d in dl:
        art = os.path.join(runs, os.path.basename(d.get("artifact_nom") or ""))
        etiquette = f"délégation #{d['seq']} ({d['role']})"
        t = tours_de(art[:-5] + ".jsonl", d["total"], etiquette)
        cote = "avant" if avant(ts(d["at"])) else "APRÈS"
        print(f"  #{d['seq']:<3} {cote:5} {d['role']:18} {str(d['unite']):5} tours {t['tours']:>3} · relevé {t['releve']:>8}"
              f" = artefact {d['total']} (rapproché) · tours à un seul appel après le premier {t['tours_a_un_seul_appel']}")
        print(f"        contexte par tour [relevé] : {' '.join(str(c) for c in t['contextes'])}")
        print(f"        appels par tour [relevé] : {' '.join(str(n) for n in t['appels_par_tour'])}")
        nat = sorted(t["natures_estime"].items(), key=lambda kv: -kv[1]["relus"])
        if nat:
            print("        résultats d'outils [estimé, caractères / 4] : " +
                  " · ".join(f"{k} {v['n']}× {v['tokens']} (relus {v['relus']})" for k, v in nat[:6]))
        sortie.append({"seq": d["seq"], **t})
    return sortie


# ------------------------------------------------------------------ cycles (--cycles, LOT-REPRISES R3)

def seq_de(nom, run_id):
    m = re.match(rf"^{re.escape(run_id)}-(\d+)-", os.path.basename(nom or ""))
    return int(m.group(1)) if m else None


def resultats_task(fichiers, run_id):
    """Les résultats `task` de l'orchestrateur, avec leurs détails structurés : porte, refus de plan."""
    out = []
    for p in fichiers:
        for e in jsonl(p):
            if e.get("type") != "message":
                continue
            m = e.get("message") or {}
            if m.get("role") != "toolResult" or m.get("toolName") != "task":
                continue
            d = m.get("details") if isinstance(m.get("details"), dict) else {}
            seqs = {seq_de(c.get("artifact"), run_id) for c in d.get("children") or [] if isinstance(c, dict)}
            seqs.add(seq_de(d.get("artifact"), run_id))
            out.append({"t": ts(e.get("timestamp")), "gate": d.get("integration_gate") if isinstance(d.get("integration_gate"), dict) else None,
                        "plan_refusal": d.get("plan_refusal") if isinstance(d.get("plan_refusal"), dict) else None,
                        "seqs": sorted(x for x in seqs if x is not None)})
    return out


def marqueurs(runs, d):
    """Dans la transcription d'un enfant, lue sans omission : refus R2 et RC (structurés) et refus R1-b (codés)."""
    tr = os.path.join(runs, os.path.basename(d.get("artifact_nom") or "")[:-5] + ".jsonl")
    if not os.path.isfile(tr):
        return None
    r2, rc, hors = 0, 0, 0
    for e in jsonl(tr):
        if e.get("type") != "tool_execution_end":
            continue
        res = e.get("result") if isinstance(e.get("result"), dict) else {}
        det = res.get("details") if isinstance(res.get("details"), dict) else {}
        if e.get("toolName") == "submit" and isinstance(det.get("refus"), dict) and \
                det["refus"].get("code") == "REVIEW_APPROVED_WITH_OPEN_RISKS":
            r2 += 1
        if e.get("toolName") == "submit" and isinstance(det.get("refus"), dict) and \
                det["refus"].get("code") == "REVIEW_BLOCKING_WITHOUT_KEPT_CONSUMERS":
            rc += 1
        if e.get("toolName") in ("edit", "write") and "WRITE_OUTSIDE_SCOPE" in texte(res.get("content")):
            hors += 1
    return {"approved_refuses_r2": r2, "revues_bloquantes_refusees": rc, "ecritures_hors_scope_refusees": hors}


def dans_scope(f, motifs):
    f = f[2:] if f.startswith("./") else f
    for brut in motifs:
        p = (brut[2:] if brut.startswith("./") else brut).rstrip("/")
        if p in ("", ".") or f == p or f.startswith(p + "/") or fnmatch.fnmatchcase(f, brut):
            return True
    return False


def scopes_du_plan(runs, run_id):
    doc = json.loads(lire_octets(os.path.join(runs, f"{run_id}-plan.json")).decode("utf-8"))
    return {str(u.get("id", "")).strip(): [str(x) for x in u.get("expected_write_scope") or []]
            for u in doc.get("work_units", []) if isinstance(u, dict)}


def cycles(runs, run_id, dl, evenements, taches, avant):
    """
    Les cycles de chaque unité, avant coupure. Un cycle de reprise est toute délégation worker d'une
    unité après son premier worker ; sa cause est ce qui a empêché l'intégration de l'état précédent :
    le `policy_blockers` de la porte relevée sur la dernière revue entre les deux workers, sinon le
    verdict structuré de cette revue (`needs_rework`, `blocked`), sinon `unknown`.
    """
    scopes = scopes_du_plan(runs, run_id)
    porte = {}
    for t in taches:
        for sq in t["seqs"]:
            if t["gate"]:
                porte[sq] = t["gate"]
    par_unite = {}
    for d in dl:
        if d["unite"] and avant(ts(d["at"])):
            par_unite.setdefault(d["unite"], []).append(d)
    journal = {d.get("seq"): d for d in jsonl(os.path.join(runs, f"{run_id}-delegations.jsonl")) if "seq" in d} \
        if os.path.isfile(os.path.join(runs, f"{run_id}-delegations.jsonl")) else {}
    integrees = {}
    for e in evenements:
        if e.get("event") == "INTEGRATED" and e.get("work_unit") not in integrees:
            integrees[e.get("work_unit")] = ts(e.get("at"))
    unites, compte = {}, {
        "worker_initial": 0, "rework_workers": 0, "reviewers": 0, "cycles_rework": 0,
        "porte_scope_breach": 0, "porte_open_risks": 0, "scope_breach_avant_premiere_integration": 0,
        "reprises_scope_breach": 0, "reprises_open_risks": 0, "approved_avec_risque_ouvert": 0,
        "approved_refuses_r2": 0, "revues_bloquantes_refusees": 0, "ecritures_hors_scope_refusees": 0,
        "transcriptions_absentes": 0,
        "plan_validation_retries": sum(1 for t in taches if t["plan_refusal"]),
    }
    for u, ds in sorted(par_unite.items()):
        ds = sorted(ds, key=lambda d: d["seq"])
        workers = [d for d in ds if d["role"] == "worker"]
        revues = [d for d in ds if d["role"] == "reviewer"]
        compte["worker_initial"] += 1 if workers else 0
        compte["rework_workers"] += max(0, len(workers) - 1)
        compte["reviewers"] += len(revues)
        for r in revues:
            g = porte.get(r["seq"]) or {}
            bloqueurs = g.get("policy_blockers") or [] if g.get("outcome") == "blocked" else []
            if "scope-breach" in bloqueurs:
                compte["porte_scope_breach"] += 1
                if u not in integrees or ts(r["at"]) < integrees[u]:
                    compte["scope_breach_avant_premiere_integration"] += 1
            if "open-risks" in bloqueurs:
                compte["porte_open_risks"] += 1
            art = lire_json(os.path.join(runs, os.path.basename(r["artifact_nom"])))
            payload = ((art.get("envelope") or {}).get("payload") or {})
            if r["verdict"] == "approved" and (payload.get("open_risks") or "open-risks" in bloqueurs):
                compte["approved_avec_risque_ouvert"] += 1
        for d in ds:
            m = marqueurs(runs, d)
            if m is None:
                compte["transcriptions_absentes"] += 1
                continue
            compte["approved_refuses_r2"] += m["approved_refuses_r2"]
            compte["revues_bloquantes_refusees"] += m["revues_bloquantes_refusees"]
            compte["ecritures_hors_scope_refusees"] += m["ecritures_hors_scope_refusees"]
        reprises = []
        for i in range(1, len(workers)):
            prec, w = workers[i - 1], workers[i]
            entre = [r for r in revues if prec["seq"] < r["seq"] < w["seq"]]
            if not entre:
                cause = {"cause": "unknown", "source": "aucune revue entre les deux workers"}
            else:
                r = entre[-1]
                g = porte.get(r["seq"]) or {}
                bloqueurs = sorted(g.get("policy_blockers") or []) if g.get("outcome") == "blocked" else []
                if bloqueurs:
                    cause = {"cause": "+".join(bloqueurs), "source": f"policy_blockers de la porte, revue #{r['seq']}"}
                    if "scope-breach" in bloqueurs:
                        ecrits = sorted({f for x in workers[:i] for f in (journal.get(x["seq"]) or {}).get("changed_files") or []})
                        # Ce que les workers précédents ont écrit hors du scope du plan (journal des délégations).
                        cause["ecrits_hors_scope"] = [f for f in ecrits if not dans_scope(f, scopes.get(u, []))]
                    if "open-risks" in bloqueurs:
                        etat = {}
                        for e in evenements:
                            # L'état des risques après cette revue : aucun worker n'en change, et la revue
                            # est la dernière avant ce worker.
                            if e.get("event") == "RISK" and e.get("work_unit") == u and ts(e.get("at")) < ts(w["at"]):
                                etat[e.get("id")] = e.get("transition")
                        cause["risques_ouverts"] = sorted(k for k, v in etat.items() if v != "resolved")
                elif r["verdict"] in ("needs_rework", "blocked"):
                    cause = {"cause": r["verdict"], "source": f"verdict structuré, revue #{r['seq']}",
                             "constats": [c for c in r["constats"] if c]}
                else:
                    cause = {"cause": "unknown", "source": f"revue #{r['seq']} {r['verdict']} sans porte relevée"}
            if "scope-breach" in cause["cause"]:
                compte["reprises_scope_breach"] += 1
            if "open-risks" in cause["cause"]:
                compte["reprises_open_risks"] += 1
            reprises.append({"worker": w["seq"], **cause})
        compte["cycles_rework"] += len(reprises)
        unites[u] = {"chaine": [f"{d['role'][0].upper()}#{d['seq']}" for d in ds], "reprises": reprises}
    return {"unites": unites, "compteurs": compte}


def imprimer_cycles(c):
    print("\n== CYCLES PAR UNITÉ (avant coupure) — causes lues dans les registres et la porte ; unknown si non démontrable")
    for u, x in c["unites"].items():
        print(f"  {u} : {' → '.join(x['chaine'])} · reprises {len(x['reprises'])}")
        for r in x["reprises"]:
            detail = ""
            if r.get("ecrits_hors_scope"):
                detail += f" · écrits hors scope par les workers précédents {', '.join(r['ecrits_hors_scope'])}"
            if r.get("risques_ouverts"):
                detail += f" · risques ouverts {', '.join(r['risques_ouverts'])}"
            if r.get("constats"):
                detail += f" · constats {','.join(r['constats'])}"
            print(f"    W#{r['worker']} ← {r['cause']} ({r['source']}){detail}")
    k = c["compteurs"]
    print("  compteurs : " + " · ".join(f"{cle} {k[cle]}" for cle in (
        "worker_initial", "rework_workers", "reviewers", "cycles_rework", "porte_scope_breach",
        "scope_breach_avant_premiere_integration", "reprises_scope_breach", "porte_open_risks",
        "reprises_open_risks", "approved_avec_risque_ouvert", "approved_refuses_r2",
        "revues_bloquantes_refusees", "ecritures_hors_scope_refusees", "plan_validation_retries", "transcriptions_absentes")))


# ------------------------------------------------------------------ postes (--postes, LOT-EFFICACITÉ M)
#
# Les règles D1 et D3 adjugées au diagnostic de LOT-EFFICACITÉ (diagnostic/d1-ventilation.py,
# d3-tours.py, commun.py), versionnées ici sans changement, et les compteurs des leviers E1-bis, E2,
# E3. Une transcription absente rend un poste NON ÉTABLI, jamais 0 ; une trace attendue absente rend
# un compteur ABSENT ou NON ÉTABLI, jamais 0.

POSTES_D1 = ["planification initiale", "refus R1-a", "réécriture après refus", "dispatch/délégation",
             "traitement des retours", "intégration / portes", "finalisation avant T", "autre / unknown"]
REFUS_PLAN = "Refused: plan invalid"
POSTES_D3 = ["lecture", "edit/write", "test", "environnement", "git", "submit", "mixed/other"]
CLASSES_TESTS = ["découverte / correction de la commande", "tests légitimes après modification",
                 "réexécution liée à un échec", "validation finale"]
LECTURE_D3 = {"read", "ls", "grep", "find"}
ENV_D3 = re.compile(r"command -v|\bwhich\b|--version|python3? -c|\buv run\b|\.venv|VIRTUAL_ENV|python-version|uv\.lock")


def nb(x):
    return f"{x:,}".replace(",", " ")


def appels_postes(fichiers, avant):
    """Les appels facturés de l'orchestrateur avant coupure, avec leurs outils, et les résultats par toolCallId."""
    appels, res = [], {}
    for p in fichiers:
        for e in jsonl(p):
            m = e.get("message") or {}
            if e.get("type") != "message":
                continue
            if m.get("role") == "toolResult":
                t = "".join(x.get("text", "") for x in m.get("content") or [] if isinstance(x, dict) and x.get("type") == "text")
                res[m.get("toolCallId")] = (t, m.get("details"))
            if m.get("role") != "assistant" or tot(m.get("usage") or {}) <= 0 or not avant(ts(e.get("timestamp"))):
                continue
            outils = [x for x in m.get("content") or [] if isinstance(x, dict) and x.get("type") == "toolCall"]
            appels.append({"at": str(e.get("timestamp")), "cout": tot(m.get("usage") or {}), "outils": outils})
    return appels, res


def chemin_arg(a):
    return str((a.get("arguments") or {}).get("path") or "")


def ventiler_d1(run_id, appels, res):
    """D1 : une catégorie par appel, décidée sur ses outils et leurs résultats ; unknown n'est jamais réaffecté."""
    plan = f"{run_id}-plan.json"
    artefact = re.compile(rf"{run_id}-\d\d-[a-z-]+\.json$")
    vu_task, dernier_plan, version, out = False, None, None, []
    for a in appels:
        noms = [o.get("name") for o in a["outils"]]
        attr = ""
        if not noms:
            cat = "finalisation avant T"
        elif "task" in noms:
            textes = [res.get(o.get("id"), ("", None))[0] for o in a["outils"] if o.get("name") == "task"]
            if set(noms) != {"task"}:
                cat, attr = "autre / unknown", "task mêlé à d'autres outils"
            elif all(t.startswith(REFUS_PLAN) for t in textes):
                cat, dernier_plan = "refus R1-a", "refus"
            elif any(t.startswith(REFUS_PLAN) for t in textes):
                cat, attr = "autre / unknown", "refus R1-a et dispatch dans le même appel"
            else:
                cat = "dispatch/délégation"
                if any(t.startswith("[task: invalid]") for t in textes):
                    attr = "invalide"
                dernier_plan = "accepte"
            vu_task = True
        elif noms == ["write"] and chemin_arg(a["outils"][0]).endswith(plan):
            contenu = (a["outils"][0].get("arguments") or {}).get("content")
            if not vu_task and version is None:
                cat, attr = "planification initiale", "première écriture du plan"
            elif dernier_plan == "refus" and contenu != version:
                cat = "réécriture après refus"
            else:
                cat, attr = "autre / unknown", "écriture du plan sans refus précédent, ou contenu identique"
            version, dernier_plan = contenu, "ecrit"
        elif not vu_task:
            cat = "planification initiale"
        elif all(o.get("name") == "read" and artefact.search(chemin_arg(o)) for o in a["outils"]):
            cat = "traitement des retours"
        else:
            cat = "autre / unknown"
            attr = "après le premier task : " + ", ".join(
                f"{o.get('name')} {os.path.basename(chemin_arg(o)) or ''}".strip() for o in a["outils"])
        out.append((a, cat, attr))
    return out


def tours_postes(transcription):
    """Les tours d'un enfant (message_end assistant), leurs appels et la fin de chacun ; et le cwd de sa session."""
    ev = jsonl(transcription)
    fins = {e.get("toolCallId"): e for e in ev if e.get("type") == "tool_execution_end"}
    cwd = next((e.get("cwd") for e in ev if e.get("type") == "session" and isinstance(e.get("cwd"), str)), None)
    out = []
    for e in ev:
        m = e.get("message") or {}
        if e.get("type") == "message_end" and m.get("role") == "assistant":
            appels = [x for x in m.get("content") or [] if isinstance(x, dict) and x.get("type") == "toolCall"]
            u = m.get("usage") or {}
            out.append({"cout": tot(u), "ctx": ctx(u), "appels": appels, "fins": [fins.get(a.get("id")) for a in appels]})
    return out, ev, cwd


def commande(a):
    return str((a.get("arguments") or {}).get("command") or "")


def est_git(c):
    segs = [s.strip() for s in re.split(r"&&|\|\||;|\n", c) if s.strip()]
    return bool(segs) and all(s.startswith("git ") or s == "git" for s in segs)


def categorie_d3(t):
    noms = [a.get("name") for a in t["appels"]]
    if not noms:
        return "mixed/other", "sans outil"
    if all(x in LECTURE_D3 for x in noms):
        return "lecture", ""
    if all(x in ("edit", "write") for x in noms):
        return "edit/write", ""
    if noms == ["submit"]:
        return "submit", ""
    if all(x == "bash" for x in noms):
        cs = [commande(a) for a in t["appels"]]
        if all("pytest" in c for c in cs):
            return "test", ""
        if not any("pytest" in c for c in cs):
            if all(est_git(c) for c in cs):
                return "git", ""
            if all(ENV_D3.search(c) and not est_git(c) for c in cs):
                return "environnement", ""
    attr = []
    if any(a.get("name") == "bash" and "pytest" in commande(a) for a in t["appels"]):
        attr.append("contient un test")
    if any(a.get("name") == "bash" and ENV_D3.search(commande(a)) and "pytest" not in commande(a) for a in t["appels"]):
        attr.append("sonde l'environnement")
    return "mixed/other", " · ".join(attr)


def forme_test(c):
    i = c.find("pytest")
    return re.sub(r"\s+", " ", c[: i + len("pytest")]).strip()


def classer_tests(lancements):
    """lancements : (index du tour, commande, réussi, code 127) des tours `test`, dans l'ordre."""
    out = {}
    for k, (i, c, ok, c127) in enumerate(lancements):
        suivant_ok = next((x for x in lancements[k + 1:] if x[2]), None)
        prec = lancements[k - 1] if k > 0 else None
        if not ok and (c127 or (suivant_ok is not None and forme_test(c) != forme_test(suivant_ok[1]))):
            cl = CLASSES_TESTS[0]
        elif prec is not None and not prec[2] and forme_test(prec[1]) == forme_test(c):
            cl = CLASSES_TESTS[2]
        elif k == len(lancements) - 1 and ok:
            cl = CLASSES_TESTS[3]
        else:
            cl = CLASSES_TESTS[1]
        out[i] = cl
    return out


def texte_fin(fin):
    if not fin:
        return ""
    r = fin.get("result") or {}
    c = r.get("content") if isinstance(r, dict) else None
    if isinstance(c, list):
        return "".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
    return str(r)


def postes_d3(tt):
    """Une catégorie primaire par tour ; les tours `test` dans une des quatre classes."""
    prem, lancements = [], []
    for i, t in enumerate(tt):
        c, attr = categorie_d3(t)
        prem.append((c, attr))
        if c == "test":
            ok = all(x is not None and x.get("isError") is False for x in t["fins"])
            c127 = any("code 127" in texte_fin(x) for x in t["fins"] if x)
            lancements.append((i, " ".join(commande(x) for x in t["appels"]), ok, c127))
    return prem, classer_tests(lancements)


def transcriptions_du_run(runs, run_id):
    out = {}
    for f in sorted(glob.glob(os.path.join(runs, f"{run_id}-[0-9][0-9]-*.jsonl"))):
        m = re.search(r"-(\d\d)-([a-z-]+)\.jsonl$", f)
        if m:
            out[int(m.group(1))] = (m.group(2), f)
    return out


def lire_trace(chemin):
    """Une trace structurée du runtime : (doc, None), (None, 'absente') ou (None, 'illisible')."""
    if not os.path.isfile(chemin):
        return None, "absente"
    try:
        return lire_json(chemin), None
    except ValueError:
        return None, "illisible"


def compteur(valeur, etat=None):
    """Un compteur établi porte une valeur ; sinon son état (absent, non établi) et la raison — jamais 0."""
    return {"valeur": valeur} if etat is None else {"valeur": None, "etat": etat}


def trace_invalide(doc, run_id, d, agent, champ, plan_hash):
    """
    Pourquoi une trace transmis.json ne se compte pas, ou None si elle se compte : forme, rattachement à la
    délégation (run, séquence, rôle, unité), et pour l'injection sa provenance (run, planHash, unité,
    séquence, arbre, fichiers) ; pour le contrat de test sa décision et ce qui a été transmis.
    """
    if not isinstance(doc, dict):
        return "trace de forme invalide"
    if doc.get("run") != run_id or doc.get("seq") != d["seq"]:
        return f"trace d'un autre run ou d'une autre séquence (run {doc.get('run')}, séquence {doc.get('seq')})"
    if doc.get("agent") != agent or doc.get("unit") != d["unite"]:
        return f"trace d'un autre rôle ou d'une autre unité ({doc.get('agent')}, {doc.get('unit')})"
    if champ not in doc:
        return f"champ {champ} absent"
    v = doc[champ]
    if champ == "injection":
        if v is None:
            return None
        if not isinstance(v, dict) or not isinstance(v.get("provenance"), dict):
            return "injection de forme invalide"
        p = v["provenance"]
        if p.get("run") != run_id or p.get("seq") != d["seq"] or p.get("unit") != d["unite"] or p.get("planHash") != plan_hash \
                or not isinstance(p.get("tree"), str) or not p.get("tree"):
            return "provenance contradictoire (run, séquence, unité, planHash ou arbre)"
        fs = p.get("files")
        if not isinstance(fs, list) or not fs or not all(
                isinstance(f, dict) and isinstance(f.get("path"), str) and isinstance(f.get("blob"), str) and f.get("blob")
                and isinstance(f.get("size"), int) and f["size"] >= 0 for f in fs):
            return "fichiers de provenance de forme invalide"
        if len({f["path"] for f in fs}) != len(fs) or v.get("octets_injectes") != sum(f["size"] for f in fs):
            return "provenance contradictoire (doublon ou octets injectés ≠ somme des tailles)"
        return None
    if not isinstance(v, dict) or v.get("transmis") not in ("etablie", "declaree", "aucune") or \
            not isinstance(v.get("decision"), dict) or v["decision"].get("etat") not in ("absent", "ignore", "transmis"):
        return "test_contract de forme invalide"
    return None


def observation_invalide(obs, verdict, d, prov, blobs):
    """
    Pourquoi l'observation d'un submit bloquant ne se compte pas, ou None : présente, lisible, du même
    verdict et de l'unité de la délégation, provenance observée = provenance transmise, et chaque kept
    retenu par injection présent dans la provenance avec un contrôle ok, blob lu = attendu = transmis.
    Un kept retenu par injection exige injection.etat = valide : absente ou invalide, l'observation est
    inexploitable, même si ses contrôles concordent (adjudication de la révision 2, correction 2).
    """
    if not isinstance(obs, dict):
        return "observation details.inspection absente ou illisible"
    if obs.get("verdict") != verdict or obs.get("unit") not in (d["unite"], None):
        return "observation d'un autre verdict ou d'une autre unité"
    inj = obs.get("injection") if isinstance(obs.get("injection"), dict) else {}
    if (obs.get("par_injection") or []) and inj.get("etat") != "valide":
        return "kept retenu par injection avec état d'injection absent ou invalide"
    if inj.get("etat") == "valide":
        vue = inj.get("provenance") or {}
        if not prov or any(vue.get(c) != prov.get(c) for c in ("run", "planHash", "unit", "seq", "tree")):
            return "provenance observée ≠ provenance transmise"
    controles = obs.get("controles") if isinstance(obs.get("controles"), list) else []
    for kp in obs.get("par_injection") or []:
        c = [x for x in controles if isinstance(x, dict) and x.get("path") == kp]
        if kp not in blobs or not c or c[-1].get("ok") is not True or not (c[-1].get("lu") == c[-1].get("attendu") == blobs[kp]):
            return f"{kp} retenu par injection sans fichier de provenance ou contrôle de blob valide"
    return None


def compteurs_postes(runs, run_id, unites, fichiers_sessions, dl, par_seq, avant):
    """
    Les compteurs des leviers, lus dans les seules traces structurées conservées du relevé, jamais
    dans l'environnement des enfants. Une trace attendue absente : « absent » si le relevé n'en
    porte aucune (run antérieur au levier), « non établi » si elle manque pour une partie des
    délégations ou se contredit. Unités, sources et doublons : voir l'aide de --postes.
    """
    k = {}
    # E1-bis : <runId>-kept.json, rapproché de details.plan_kept des résultats `task` de la session.
    manifeste, _ = manifeste_du_run(runs, run_id)
    doc, pb = lire_trace(os.path.join(runs, f"{run_id}-kept.json"))
    publies = []
    for p in fichiers_sessions:
        for e in jsonl(p):
            m = e.get("message") or {}
            if e.get("type") == "message" and m.get("role") == "toolResult" and isinstance(m.get("details"), dict) \
                    and isinstance(m["details"].get("plan_kept"), dict):
                publies.append(m["details"]["plan_kept"])
    if doc is None and pb == "absente" and not publies:
        k["kept_derives"] = k["kept_retires"] = compteur(None, f"absent : ni {run_id}-kept.json ni details.plan_kept")
    elif doc is None:
        k["kept_derives"] = k["kept_retires"] = compteur(None, f"non établi : {run_id}-kept.json {pb}")
    elif doc.get("schema") != "pi-kept/1" or doc.get("planHash") != manifeste.get("planHash") or \
            not isinstance(doc.get("units"), dict) or any(u not in doc["units"] for u in unites):
        k["kept_derives"] = k["kept_retires"] = compteur(None, f"non établi : {run_id}-kept.json ne correspond pas au plan gelé")
    elif any({u: (x or {}).get("kept") for u, x in pub.items()} != {u: (x or {}).get("kept") for u, x in doc["units"].items()}
             for pub in publies):
        k["kept_derives"] = k["kept_retires"] = compteur(None, "non établi : details.plan_kept diffère du kept durable")
    else:
        k["kept_derives"] = compteur(sum(len(x.get("derived") or []) for x in doc["units"].values()))
        k["kept_retires"] = compteur(sum(len(x.get("dropped") or []) for x in doc["units"].values()))

    # E2 : <runId>-<NN>-transmis.json de chaque revue de lane, details.inspection de ses submits bloquants.
    # Correction 3 de l'adjudication de la livraison (02-10) : chaque trace comptée est valide et rattachée
    # à sa délégation ; chaque submit bloquant, apparié par toolCallId, porte une observation cohérente.
    plan_hash = manifeste.get("planHash")
    revues = [d for d in dl if d["role"] == "reviewer" and d["unite"] and avant(ts(d["at"]))]
    traces, manquantes, contradictoires = {}, [], []
    for d in revues:
        doc_, pb_ = lire_trace(os.path.join(runs, f"{run_id}-{d['seq']:02d}-transmis.json"))
        if doc_ is None and pb_ == "absente":
            manquantes.append(d["seq"])
            continue
        defaut = trace_invalide(doc_, run_id, d, "reviewer", "injection", plan_hash) if doc_ is not None else "illisible"
        if defaut:
            contradictoires.append(f"#{d['seq']} {defaut}")
        else:
            traces[d["seq"]] = doc_
    noms = ("fichiers_injectes", "octets_injectes", "relectures_injectees", "kept_inspectes_par_injection")
    if not revues or (len(manquantes) == len(revues)):
        for c in noms:
            k[c] = compteur(None, "absent : aucune trace transmis.json d'une revue" if revues else "absent : aucune revue de lane avant coupure")
    elif manquantes or contradictoires:
        raisons = ([f"trace absente pour #{', #'.join(str(s) for s in manquantes)}"] if manquantes else []) + contradictoires
        for c in noms:
            k[c] = compteur(None, f"non établi : {' ; '.join(raisons)}")
    else:
        fichiers = octets = relectures = 0
        inspectes, sans_transcription, observations = set(), [], []
        for d in revues:
            inj = traces[d["seq"]]["injection"]
            prov = (inj or {}).get("provenance") or {}
            blobs = {f["path"]: f["blob"] for f in prov.get("files") or []}
            fichiers += len(blobs)
            octets += (inj or {}).get("octets_injectes") or 0
            seq_tr = par_seq.get(d["seq"])
            if not seq_tr:
                sans_transcription.append(d["seq"])
                continue
            _, ev, cwd = tours_postes(seq_tr[1])
            debuts = {}
            for e in ev:
                if e.get("type") == "tool_execution_start":
                    debuts[e.get("toolCallId")] = e
                    if e.get("toolName") == "read" and cwd:
                        p = str((e.get("args") or {}).get("path") or "")
                        rel = os.path.relpath(os.path.normpath(os.path.join(cwd, p)), cwd)
                        if rel in blobs:
                            relectures += 1
            for e in ev:
                if e.get("type") != "tool_execution_end" or e.get("toolName") != "submit":
                    continue
                ident = e.get("toolCallId")
                debut = debuts.get(ident)
                if debut is None:
                    observations.append(f"#{d['seq']} {ident} : submit sans début apparié")
                    continue
                verdict = (debut.get("args") or {}).get("verdict")
                if verdict not in ("needs_rework", "blocked"):
                    continue
                det = (e.get("result") or {}).get("details") if isinstance(e.get("result"), dict) else None
                obs = det.get("inspection") if isinstance(det, dict) else None
                defaut = observation_invalide(obs, verdict, d, prov, blobs)
                if defaut:
                    observations.append(f"#{d['seq']} {ident} : {defaut}")
                    continue
                for kp in (obs or {}).get("par_injection") or []:
                    inspectes.add((d["seq"], kp))
        k["fichiers_injectes"] = compteur(fichiers)
        k["octets_injectes"] = compteur(octets)
        if sans_transcription:
            raison = f"non établi : transcription absente pour #{', #'.join(str(s) for s in sans_transcription)}"
            k["relectures_injectees"] = k["kept_inspectes_par_injection"] = compteur(None, raison)
        else:
            k["relectures_injectees"] = compteur(relectures)
            k["kept_inspectes_par_injection"] = compteur(len(inspectes)) if not observations else \
                compteur(None, f"non établi : {' ; '.join(observations)}")

    # E3 (§ 4.5) : la décision du contrat de test et ce que le premier writer de lane a reçu (test_contract de sa
    # trace transmis.json, valide et rattachée à sa délégation), puis les tours D3 de ce premier writer.
    writers = sorted((d for d in dl if d["role"] == "worker" and d["unite"] and avant(ts(d["at"]))), key=lambda d: d["seq"])
    noms = ("contrat_test", "tours_decouverte_test", "tours_environnement")
    contrats = {d["seq"]: lire_trace(os.path.join(runs, f"{run_id}-{d['seq']:02d}-transmis.json")) for d in writers}
    presentes = [s for s, (doc_, pb_) in contrats.items() if pb_ != "absente"]
    if not writers or not presentes:
        for c in noms:
            k[c] = compteur(None, "absent : aucune trace test_contract d'un writer" if writers else "absent : aucun writer de lane avant coupure")
    else:
        premier = writers[0]
        doc_, pb_ = contrats[premier["seq"]]
        defaut = ("trace absente" if pb_ == "absente" else "illisible") if doc_ is None else \
            trace_invalide(doc_, run_id, premier, "worker", "test_contract", plan_hash)
        if defaut:
            for c in noms:
                k[c] = compteur(None, f"non établi : test_contract du premier writer #{premier['seq']} : {defaut}")
        else:
            tc = doc_["test_contract"]
            k["contrat_test"] = compteur({"decision": tc["decision"]["etat"], "premier_writer": tc["transmis"]})
            if premier["seq"] not in par_seq:
                raison = f"non établi : transcription absente pour #{premier['seq']}"
                k["tours_decouverte_test"] = k["tours_environnement"] = compteur(None, raison)
            else:
                tt, _, _ = tours_postes(par_seq[premier["seq"]][1])
                prem, cl = postes_d3(tt)
                k["tours_decouverte_test"] = compteur(sum(1 for i in cl if cl[i] == CLASSES_TESTS[0]))
                k["tours_environnement"] = compteur(sum(1 for c, _ in prem if c == "environnement"))
    return k


def imprimer_compteur(nom, c):
    v = c["valeur"]
    if v is None:
        return f"{nom} {c['etat']}"
    if isinstance(v, dict):
        return f"{nom} " + " ".join(f"{a}={b}" for a, b in v.items())
    return f"{nom} {v}"


def postes(runs, run_id, unites, fichiers_sessions, dl, releves, coupure, avant):
    """
    --postes : D1 et D3, rapprochés à la grille, puis les compteurs des leviers. Rend le dictionnaire
    pour --json ; la somme des écarts absolus doit être nulle.
    """
    appels, res = appels_postes(fichiers_sessions, avant)
    v = ventiler_d1(run_id, appels, res)
    orch = releves["orchestrateur"]["avant"]
    par_tr = transcriptions_du_run(runs, run_id)
    par_d = {d["seq"]: d for d in dl}
    seqs = sorted(set(par_tr) | set(par_d))
    ecarts, non_etablis = 0, []

    print("\n== POSTES — D1 : l'orchestrateur avant coupure, une catégorie par appel ; unknown jamais réaffecté")
    if coupure is None:
        print("  ATTENTION : aucune coupure (plan jamais terminal) — chiffres exclus de toute comparaison fonctionnelle")
    par = {c: [0, 0] for c in POSTES_D1}
    for a, c, _ in v:
        par[c][0] += 1
        par[c][1] += a["cout"]
    somme = sum(x[1] for x in par.values())
    e1, e2 = somme - orch, len(appels) - sum(x[0] for x in par.values())
    ecarts += abs(e1) + abs(e2)
    print(f"  orchestrateur avant T : {nb(orch)} (run-cost) · {len(appels)} appels · somme des catégories {nb(somme)} · écart {e1}")
    for c in POSTES_D1:
        print(f"    {c:26s} {par[c][0]:3d} appels  {nb(par[c][1]):>11}")
    residuel = orch - par["refus R1-a"][1] - par["réécriture après refus"][1]
    print(f"  résiduel orchestrateur hors refus R1-a et réécritures : {nb(residuel)}")
    print("  appels, dans l'ordre :")
    for a, c, attr in v:
        outils = ", ".join(f"{o.get('name')}" for o in a["outils"]) or "—"
        print(f"    {a['at'][11:19]} {nb(a['cout']):>9}  {c:26s} [{outils}]{' · ' + attr if attr else ''}")
    print(f"  sous-agents avant T : {nb(releves['sous_agents']['avant'])} · " +
          " · ".join(f"{r} {nb(x['avant'])}" for r, x in sorted(releves["par_role"].items())))
    print(f"  TOTAL avant T : {nb(releves['total']['avant'])} · après : {nb(releves['total']['apres'])}")
    d3 = {}
    for seq in seqs:
        d = par_d.get(seq)
        role = par_tr[seq][0] if seq in par_tr else d["role"]
        cote = "avant T" if d and avant(ts(d["at"])) else "après T"
        if seq not in par_tr:
            non_etablis.append(seq)
            print(f"    #{seq:02d} {role:9s} {cote:8s} transcription absente : non établi · run-cost {nb(d['total']):>10}")
            continue
        tt, _, _ = tours_postes(par_tr[seq][1])
        d3[seq] = tt
        st_ = sum(t["cout"] for t in tt)
        ecart = st_ - (d["total"] if d else 0)
        ecarts += abs(ecart)
        print(f"    #{seq:02d} {role:9s} {cote:8s} transcription {nb(st_):>10} · run-cost {nb(d['total'] if d else 0):>10} · écart {ecart}")

    print("\n== POSTES — D3 : une catégorie primaire par tour, sommes exactes ; tests en quatre classes")
    agreg = {}
    for seq in seqs:
        d = par_d.get(seq)
        role = par_tr[seq][0] if seq in par_tr else d["role"]
        av = bool(d) and avant(ts(d["at"]))
        if seq not in d3:
            print(f"  #{seq:02d} {role} · {'avant T' if av else 'APRÈS T'} · transcription absente : postes non établis")
            if av:
                agreg.setdefault(role, {"n": 0, "total": 0, "cats": {c: 0 for c in POSTES_D3}, "tests": {c: 0 for c in CLASSES_TESTS},
                                        "tours": 0, "un_appel": 0, "absentes": 0})["absentes"] += 1
            continue
        if d is None:
            somme_ = sum(t["cout"] for t in d3[seq])
            print(f"  #{seq:02d} {role} · transcription sans délégation au journal · écart {somme_}")
            continue
        tt = d3[seq]
        prem, cl = postes_d3(tt)
        cats = {c: [0, 0] for c in POSTES_D3}
        classes = {c: [0, 0] for c in CLASSES_TESTS}
        lignes = []
        for i, t in enumerate(tt):
            c, attr = prem[i]
            cats[c][0] += 1
            cats[c][1] += t["cout"]
            if i in cl:
                classes[cl[i]][0] += 1
                classes[cl[i]][1] += t["cout"]
            outils = ", ".join(a.get("name") for a in t["appels"]) or "—"
            seconds = [x for x in (attr, "un seul appel" if len(t["appels"]) == 1 and i > 0 else "", cl.get(i, "")) if x]
            lignes.append(f"      t{i + 1:02d} {nb(t['cout']):>9} ctx {nb(t['ctx']):>7}  {c:13s} [{outils}]"
                          f"{' · ' + ' · '.join(seconds) if seconds else ''}")
        somme_ = sum(x[1] for x in cats.values())
        ecart = somme_ - d["total"]
        ecarts += abs(ecart)
        print(f"  #{seq:02d} {role} · {'avant T' if av else 'APRÈS T'} · {len(tt)} tours · total {nb(d['total'])} · "
              f"somme des catégories {nb(somme_)} · écart {ecart}")
        for c in POSTES_D3:
            if cats[c][0]:
                print(f"    {c:13s} {cats[c][0]:3d} tours {nb(cats[c][1]):>11}  {100 * cats[c][1] / d['total']:5.1f} %")
        if cl:
            for c in CLASSES_TESTS:
                if classes[c][0]:
                    print(f"      test · {c:38s} {classes[c][0]:2d} tours {nb(classes[c][1]):>10}")
        for x in lignes:
            print(x)
        if av:
            a = agreg.setdefault(role, {"n": 0, "total": 0, "cats": {c: 0 for c in POSTES_D3}, "tests": {c: 0 for c in CLASSES_TESTS},
                                        "tours": 0, "un_appel": 0, "absentes": 0})
            a["n"] += 1
            a["total"] += d["total"]
            a["tours"] += len(tt)
            a["un_appel"] += sum(1 for i, t in enumerate(tt) if i > 0 and len(t["appels"]) == 1)
            for c in POSTES_D3:
                a["cats"][c] += cats[c][1]
            for c in CLASSES_TESTS:
                a["tests"][c] += classes[c][1]
    print("  synthèse avant T, par rôle (tokens ; part du rôle)")
    for role, a in agreg.items():
        if not a["n"]:
            print(f"  {role:9s} non établi : {a['absentes']} transcription(s) absente(s)")
            continue
        parts = " · ".join(f"{c} {nb(x)} ({100 * x / a['total']:.1f} %)" for c, x in a["cats"].items() if x)
        incomplet = f" · INCOMPLET : {a['absentes']} transcription(s) absente(s), non établie(s)" if a["absentes"] else ""
        print(f"  {role:9s} n={a['n']} · total {nb(a['total'])} · tours {a['tours']} (dont {a['un_appel']} à un seul appel après t1){incomplet}")
        print(f"      {parts}")
        if any(a["tests"].values()):
            print("      tests : " + " · ".join(f"{c} {nb(x)}" for c, x in a["tests"].items() if x))

    k = compteurs_postes(runs, run_id, unites, fichiers_sessions, dl, par_tr, avant)
    print("\n== POSTES — compteurs des leviers (traces structurées du relevé ; absent ou non établi, jamais 0 par défaut)")
    print("  " + " · ".join(imprimer_compteur(c, k[c]) for c in (
        "kept_derives", "kept_retires", "fichiers_injectes", "octets_injectes", "relectures_injectees",
        "kept_inspectes_par_injection", "contrat_test", "tours_decouverte_test", "tours_environnement")))
    print(f"  rapprochements D1 et D3 : somme des écarts absolus = {ecarts} ({'NUL' if ecarts == 0 else 'NON NUL'})"
          + (f" · transcriptions absentes, non établies : #{', #'.join(str(s) for s in non_etablis)}" if non_etablis else ""))
    return {"d1": {c: {"appels": par[c][0], "tokens": par[c][1]} for c in POSTES_D1}, "residuel_hors_r1a": residuel,
            "d3_par_role": agreg, "compteurs": k, "ecarts": ecarts, "transcriptions_absentes": non_etablis}


# ------------------------------------------------------------------ grille

def main(argv):
    try:
        return analyser(argv)
    except Refus as r:
        print(f"PRÉCONDITION — {r}")
        return 2


def analyser(argv):
    if len(argv) < 3:
        print(__doc__)
        return 2
    runs, sessions = argv[1], argv[2]
    coupure_arg, sortie_json, run_explicite, sessions_explicites = "auto", None, None, []
    avec_tours, avec_cycles, avec_postes = False, False, False
    i = 3
    while i < len(argv):
        if argv[i] == "--postes":
            avec_postes = True
            i += 1
            continue
        if argv[i] == "--tours":
            avec_tours = True
            i += 1
            continue
        if argv[i] == "--cycles":
            avec_cycles = True
            i += 1
            continue
        if argv[i] in ("--coupure", "--json", "--run", "--session") and i + 1 < len(argv):
            cle, valeur = argv[i], argv[i + 1]
            if cle == "--coupure":
                coupure_arg = valeur
            elif cle == "--json":
                sortie_json = valeur
            elif cle == "--run":
                run_explicite = valeur
            else:
                sessions_explicites.append(valeur)
            i += 2
        else:
            raise Refus(f"argument inconnu ou incomplet : {argv[i]}")
    if not os.path.isdir(runs):
        raise Refus(f"{runs} n'est pas un dossier")

    run_id, comment_run = choisir_run(runs, run_explicite)
    unites, avec_du, plan_dit = plan_verifie(runs, run_id)
    autres = [r for r in runs_du_dossier(runs) if r != run_id]
    fichiers_sessions, comment_sessions = choisir_sessions(sessions, run_id, autres, sessions_explicites)
    lanes = os.path.join(runs, f"{run_id}-lanes.jsonl")
    evenements = [e for e in jsonl(lanes) if "event" in e] if os.path.isfile(lanes) else []
    if coupure_arg == "auto":
        at = instant_terminal(evenements, unites, avec_du)
        coupure = ts(at) if at else None
        source = f"plan terminal au registre ({at})" if at else "plan jamais terminal : pas de coupure"
    elif coupure_arg == "aucune":
        coupure, source = None, "aucune coupure demandée"
    else:
        coupure, source = ts(coupure_arg), f"coupure imposée {coupure_arg}"
    avant = (lambda t: coupure is None or t < coupure)

    appels, resultats, compactions = orchestrateur(fichiers_sessions)
    dl = delegations(runs, run_id)
    grille = {"run": run_id, "selection_run": comment_run, "plan": plan_dit,
              "sessions": [os.path.basename(f) for f in fichiers_sessions], "selection_sessions": comment_sessions,
              "unites": unites, "coupure": source}

    print(f"run {run_id} ({comment_run}) · unités {' '.join(unites) or '—'} · design_update {'oui' if avec_du else 'non'}")
    print(f"plan : {plan_dit}")
    print(f"sessions ({comment_sessions}) : {', '.join(os.path.basename(f) for f in fichiers_sessions)}")
    print(f"coupure : {source}")

    # ---- relevés
    def somme(lignes, cle):
        return sum((x["u"].get(cle) or 0) for x in lignes)
    o_av = [a for a in appels if avant(a["t"])]
    o_ap = [a for a in appels if not avant(a["t"])]
    d_av = [d for d in dl if avant(ts(d["at"]))]
    d_ap = [d for d in dl if not avant(ts(d["at"]))]
    o = lambda xs: sum(tot(a["u"]) for a in xs)
    s = lambda xs: sum(d["total"] for d in xs)
    print("\n== RELEVÉS — tokens facturés (entrée + cache relu + cache écrit + sortie)")
    print(f"  {'':22} {'avant coupure':>14} {'après':>12} {'run entier':>12}")
    print(f"  {'orchestrateur':22} {o(o_av):>14} {o(o_ap):>12} {o(appels):>12}")
    roles = sorted({d["role"] for d in dl})
    for r in roles:
        fa = [d for d in d_av if d["role"] == r]; fp = [d for d in d_ap if d["role"] == r]
        print(f"  {r + f' ({len(fa)}+{len(fp)})':22} {s(fa):>14} {s(fp):>12} {s(fa) + s(fp):>12}")
    print(f"  {'sous-agents':22} {s(d_av):>14} {s(d_ap):>12} {s(dl):>12}")
    print(f"  {'TOTAL':22} {o(o_av) + s(d_av):>14} {o(o_ap) + s(d_ap):>12} {o(appels) + s(dl):>12}")
    grille["releves"] = {
        "orchestrateur": {"avant": o(o_av), "apres": o(o_ap)},
        "sous_agents": {"avant": s(d_av), "apres": s(d_ap)},
        "par_role": {r: {"avant": s([d for d in d_av if d["role"] == r]), "apres": s([d for d in d_ap if d["role"] == r])} for r in roles},
        "total": {"avant": o(o_av) + s(d_av), "apres": o(o_ap) + s(d_ap)},
    }
    print(f"\n  orchestrateur avant coupure : {len(o_av)} appels · entrée {somme(o_av, 'input')} · cache relu "
          f"{somme(o_av, 'cacheRead')} · sortie {somme(o_av, 'output')} · contexte médian {med([ctx(a['u']) for a in o_av])}"
          f" · pic {max([ctx(a['u']) for a in o_av] or [0])}")

    # ---- orchestrateur : décomposition estimée
    print("\n== ORCHESTRATEUR — décomposition du contexte [estimé : caractères / 4, avant coupure]")
    natures = {}
    for r in resultats:
        if not avant(r["t"]):
            continue
        n = classer(r["outil"], r["args"])
        est = r["chars"] // 4
        rel = residence(r, [a for a in appels if avant(a["t"])], compactions)
        x = natures.setdefault(n, {"n": 0, "tokens": 0, "residence": 0})
        x["n"] += 1; x["tokens"] += est; x["residence"] += est * rel
    total_res = sum(x["residence"] for x in natures.values()) or 1
    print(f"  {'nature':28} {'n':>4} {'tokens':>9} {'relus ensuite':>14} {'part':>6}")
    for n, x in sorted(natures.items(), key=lambda kv: -kv[1]["residence"]):
        print(f"  {n:28} {x['n']:>4} {x['tokens']:>9} {x['residence']:>14} {100 * x['residence'] / total_res:>5.1f}%")
    grille["orchestrateur_natures_estime"] = natures

    lus = {}
    for r in resultats:
        if avant(r["t"]) and r["outil"] == "read":
            lus.setdefault((r["chemin"], r["empreinte"]), []).append(r["chars"] // 4)
    relus = {f"{c}": {"fois": len(v), "tokens_chaque": v[0]} for (c, _), v in lus.items() if len(v) > 1}
    print(f"\n  relectures d'un contenu identique [estimé] : {len(relus)} chemin(s), "
          f"{sum((v['fois'] - 1) * v['tokens_chaque'] for v in relus.values())} tokens relus pour rien à la lecture")
    for c, v in sorted(relus.items(), key=lambda kv: -kv[1]["fois"] * kv[1]["tokens_chaque"])[:8]:
        print(f"    {v['fois']}× {v['tokens_chaque']:>6}  {c}")
    grille["relectures_estime"] = relus

    sorties = sorted((a["u"].get("output") or 0 for a in o_av), reverse=True)
    print(f"\n  verbosité : sortie totale {sum(sorties)} · médiane {med(sorties)} · 5 plus longues {sorties[:5]}"
          f" · texte visible {sum(a['texte'] for a in o_av) // 4} [estimé]")

    # ---- délégations
    print("\n== DÉLÉGATIONS")
    for d in dl:
        cote = "avant" if avant(ts(d["at"])) else "APRÈS"
        print(f"  #{d['seq']:<3} {cote:5} {d['role']:18} {str(d['unite']):5} tours {d['tours']:>3} · total {d['total']:>8}"
              f" · cache relu {100 * d['part_cache']:>5.1f}% · injecté {d['injecte']} · {d['duree_s']} s"
              f"{' · verdict ' + str(d['verdict']) if d['role'] == 'reviewer' else ''}"
              f"{' · constats ' + ','.join(x for x in d['constats'] if x) if d['constats'] else ''}"
              f"{' · ÉCHEC ' + str(d['echec']) if d['echec'] else ''}")
        if d["outils"]:
            print(f"        outils {d['outils']}" + (f" · relectures {d['relectures']}" if d["relectures"] else ""))
    grille["delegations"] = dl

    # ---- allers-retours par unité
    print("\n== ALLERS-RETOURS PAR UNITÉ (avant coupure)")
    par_unite = {}
    for d in d_av:
        if d["unite"]:
            par_unite.setdefault(d["unite"], []).append(d)
    for u, ds in sorted(par_unite.items()):
        suite = " → ".join(f"{d['role'][0].upper()}#{d['seq']}" + (f"({d['verdict']})" if d["role"] == "reviewer" else "") for d in ds)
        workers = sum(1 for d in ds if d["role"] == "worker")
        print(f"  {u} : {suite} · workers {workers} · reprises {max(0, workers - 1)}")
    grille["par_unite"] = {u: [d["seq"] for d in ds] for u, ds in par_unite.items()}

    if avec_tours:
        grille["tours"] = imprimer_tours(runs, dl, avant)

    if avec_cycles:
        c = cycles(runs, run_id, dl, evenements, resultats_task(fichiers_sessions, run_id), avant)
        imprimer_cycles(c)
        grille["cycles"] = c

    code = 0
    if avec_postes:
        grille["postes"] = postes(runs, run_id, unites, fichiers_sessions, dl, grille["releves"], coupure, avant)
        code = 0 if grille["postes"]["ecarts"] == 0 else 1

    if sortie_json:
        with open(sortie_json, "w", encoding="utf-8") as f:
            json.dump(grille, f, ensure_ascii=False, indent=2)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
