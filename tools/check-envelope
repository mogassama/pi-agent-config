#!/usr/bin/env python3
"""Validate the JSON envelope in the most recent subagent artifact."""
import json, re, sys, glob, os

files = sorted(
    glob.glob(os.path.expanduser("~/.pi/agent/.pi-subagents/artifacts/*_output.md")),
    key=os.path.getmtime,
)
if not files:
    sys.exit("no artifact found")

raw = open(files[-1]).read()
print(f"artifact: {os.path.basename(files[-1])}")

blocks = re.findall(r"```json\s*(.*?)```", raw, re.S)
if not blocks:
    sys.exit("FAIL: no fenced json block")
try:
    env = json.loads(blocks[-1])
except json.JSONDecodeError as e:
    sys.exit(f"FAIL: parse error: {e}")

missing = [k for k in ("agent", "status", "summary") if k not in env]
if missing:
    sys.exit(f"FAIL: missing fields: {missing}")
print(f"OK: {env['agent']} · {env['status']}")
